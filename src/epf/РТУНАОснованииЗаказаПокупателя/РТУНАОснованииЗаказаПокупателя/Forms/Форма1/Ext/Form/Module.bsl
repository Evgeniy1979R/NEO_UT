                               
&НаСервере
Функция ЕстьНеКорректныеЦены (СсылкаНаЗаказ)
	Отказ = Ложь;
	ЕстьОшибкиЦен = Ложь;
	Для Каждого сТовары из СсылкаНаЗаказ.Товары Цикл
		Если Не сТовары.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется
			и
			(сТовары.Цена < 17 или сТовары.ВидЦены = Справочники.ВидыЦен.ПустаяСсылка()) Тогда
			ЕстьОшибкиЦен = Истина;
			Отказ = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Отказ;
КонецФункции

&НаКлиенте
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначения, СозданныеОбъекты) Экспорт
	
	Если ИдентификаторКоманды = "СоздатьРТУТест" Тогда
		Открыть();
		Если ОбъектыНазначения.Количество() > 1 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Нельзя использовать команду более чем для одного документа!";
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;
		ЗакрыватьФорму = Истина;
		Если ЕстьНеКорректныеЦены(ОбъектыНазначения[0]) = Ложь Тогда
			СоздатьДокументыРТУ(ОбъектыНазначения,Ложь,ЗакрыватьФорму);
			Если ЗакрыватьФорму  = Истина Тогда
				Закрыть(Истина);
			КонецЕсли;
			
		Иначе
			
			
			Заказ = ОбъектыНазначения[0];
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтладкаИсправитьЗаказПоОрдерам(Команда)
	
	ОбъектыНазначения = Новый Массив;
	ОбъектыНазначения.Добавить(Заказ);
	РазбитиьСтрокиЗаказовПоРасходнымОрдерам(ОбъектыНазначения);
	ПоказатьПредупреждение(,"Выполнено",30,"Выполнено");
	
КонецПроцедуры


&НаКлиенте
Процедура ПодверждаюПравильностьЦенВДокументе(Команда)
	ОбъектыНазначения = Новый Массив;
	ОбъектыНазначения.Добавить(Заказ);
	Закрывать = Истина;
	СоздатьДокументыРТУ(ОбъектыНазначения,Истина,Закрывать);
	Если Закрывать = Истина Тогда
		Закрыть(Истина);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветНаВопросОПримененииНеКорректныхЦен (Ответ,ДополнительныеПараметры) Экспорт
	
	Подтверждаю = Ложь;
	Если Ответ = "Отказываюсь" Тогда
		Возврат;
	ИначеЕсли Ответ = "Подтверждаю" Тогда
		Подтверждаю = Истина;
	КонецЕсли;
	
	ОбъектыНазначения = ДополнительныеПараметры.ОбъектыНазначения;
	СоздатьДокументыРТУ(ОбъектыНазначения,Подтверждаю,Истина);

КонецПроцедуры

&НаКлиенте
Процедура ИсправитьЗаказыПоОрдерам(ОбъектыНазначения)
	МассивФормДляОбновления = Новый Массив;
	Для Каждого Э из ОбъектыНазначения Цикл
		Ф = ПолучитьФорму("Документ.ЗаказКлиента.ФормаОбъекта",Новый Структура("Ключ",Э ));
		Если Ф.Открыта() Тогда
			МассивФормДляОбновления.Добавить(Ф);
		КонецЕсли;
	КонецЦикла;
	РазбитиьСтрокиЗаказовПоРасходнымОрдерам(ОбъектыНазначения);
	Для Каждого Э Из МассивФормДляОбновления Цикл
		Э.Прочитать();
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РазбитиьСтрокиЗаказовПоРасходнымОрдерам(ОбъектыНазначения)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивЗаказов",ОбъектыНазначения);
	Запрос.Текст = "ВЫБРАТЬ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка КАК Ссылка,
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение КАК Распоряжение
	|ПОМЕСТИТЬ ОрдераСОснованиями
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
	|ГДЕ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение В(&МассивЗаказов)
	|	И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка.ПометкаУдаления = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка,
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОрдераСОснованиями.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ УсловиеВОдномОрдереОдинЗаказ
	|ИЗ
	|	ОрдераСОснованиями КАК ОрдераСОснованиями
	|
	|СГРУППИРОВАТЬ ПО
	|	ОрдераСОснованиями.Ссылка
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОрдераСОснованиями.Распоряжение) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОрдераСОснованиями.Распоряжение КАК Распоряжение
	|ПОМЕСТИТЬ УсловиеОдинЗаказОдинОрдер
	|ИЗ
	|	ОрдераСОснованиями КАК ОрдераСОснованиями
	|
	|СГРУППИРОВАТЬ ПО
	|	ОрдераСОснованиями.Распоряжение
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОрдераСОснованиями.Ссылка) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Распоряжение КАК ЗаказКлиента,
	|	ВложенныйЗапрос.Ссылка КАК РасходныйОрдер,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура КАК Номенклатура,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Характеристика КАК Характеристика,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Количество КАК Количество,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.НомерСтроки КАК НомерСтроки,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Упаковка КАК Упаковка,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия КАК Серия
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОрдераСОснованиями.Ссылка КАК Ссылка,
	|		ОрдераСОснованиями.Распоряжение КАК Распоряжение
	|	ИЗ
	|		ОрдераСОснованиями КАК ОрдераСОснованиями
	|	ГДЕ
	|		ОрдераСОснованиями.Ссылка В
	|				(ВЫБРАТЬ
	|					УсловиеВОдномОрдереОдинЗаказ.Ссылка КАК Ссылка
	|				ИЗ
	|					УсловиеВОдномОрдереОдинЗаказ КАК УсловиеВОдномОрдереОдинЗаказ)
	|		И ОрдераСОснованиями.Распоряжение В
	|				(ВЫБРАТЬ
	|					УсловиеОдинЗаказОдинОрдер.Распоряжение КАК Распоряжение
	|				ИЗ
	|					УсловиеОдинЗаказОдинОрдер КАК УсловиеОдинЗаказОдинОрдер)) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдерНаТовары.ОтгружаемыеТовары КАК РасходныйОрдерНаТоварыОтгружаемыеТовары
	|		ПО ВложенныйЗапрос.Ссылка = РасходныйОрдерНаТоварыОтгружаемыеТовары.Ссылка";
	ДанныеОрдеров = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.Прямой);
	
	Для Каждого ЗаказКлиента из ОбъектыНазначения Цикл
		НеДостаточноТоваровВОрдере = Ложь;
		НайденныеСтроки = ДанныеОрдеров.НайтиСтроки(Новый Структура("ЗаказКлиента",ЗаказКлиента));
		Если НайденныеСтроки.Количество() = 0 Тогда
			
			Сообщение				= Новый СообщениеПользователю;
			Сообщение.Текст			= СтрШаблон("Для заказа клиента %1 не найден расходный ордер",ЗаказКлиента);
			Сообщение.КлючДанных	= ЗаказКлиента;
			Сообщение.Сообщить();
			Продолжить;
			
		КонецЕсли;
		ДанныеОрдера = ДанныеОрдеров.Скопировать(НайденныеСтроки);
		оЗаказКлиента = ЗаказКлиента.ПолучитьОбъект();
		
		Товары = оЗаказКлиента.Товары;
		ТоварыИсходная = Товары.Выгрузить();
		Товары.Очистить();
		
		Для Каждого сТоварыИсходная из ТоварыИсходная Цикл
			Если сТоварыИсходная.СуммаАвтоматическойСкидки <> 0 или
				сТоварыИсходная.ПроцентАвтоматическойСкидки <> 0 Тогда

				ВызватьИсключение("Использование автоматических скидок не предусмотрено!");

			КонецЕсли;
			
			Пока сТоварыИсходная.Количество > 0  Цикл
				сТовары = Товары.Добавить();
				ЗаполнитьЗначенияСвойств(сТовары,сТоварыИсходная);
				сТовары.КодСтроки = сТовары.НомерСтроки;
				сТовары.КлючСвязи = сТовары.НомерСтроки;
				Если Не сТовары.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить Тогда

					сТоварыИсходная.Количество = 0;
					сТоварыИсходная.КоличествоУпаковок =0;
					Продолжить;

				КонецЕсли;
				СтрокиОрдера = ДанныеОрдера.НайтиСтроки(Новый Структура("Номенклатура,Характеристика",сТовары.Номенклатура,сТовары.Характеристика ));
				// ищем строку совпадающую с ордером или наиболее подходящцю
				НайденнаяСтрока = СтрокиОрдера[0];
				
				Расхождение = сТоварыИсходная.Количество - СтрокиОрдера[0].Количество;
				Расхождение = Макс(-Расхождение,Расхождение);
				НайденаСтрокаСНужнымКоличеством = Ложь;

				Для Каждого СтрокаОрдера из СтрокиОрдера Цикл

					Если СтрокаОрдера.Количество = сТоварыИсходная.Количество Тогда

						НайденнаяСтрока = СтрокаОрдера;
						Прервать;

					КонецЕсли;
					
					Р = сТоварыИсходная.Количество - СтрокаОрдера.Количество;
					Р = Макс(-Р,Р);

					Если Р < Расхождение Тогда

						Расхождение			= Р;
						НайденнаяСтрока		= СтрокаОрдера;

					КонецЕсли;
				КонецЦикла;
				
				Если  НайденнаяСтрока.Количество = 0 Тогда
					
					РассчитатьСуммуСтрокиТЧ(сТовары,оЗаказКлиента.ЦенаВключаетНДС);
					НеДостаточноТоваровВОрдере = Истина;
					Прервать;
					
				КонецЕсли;
				
				Списать						= Мин(сТовары.Количество,НайденнаяСтрока.Количество);
				СТовары.КоличествоУпаковок	= Стовары.КоличествоУпаковок*Списать/СТовары.Количество;
				сТовары.СуммаРучнойСкидки	= сТовары.СуммаРучнойСкидки * Списать / сТовары.Количество;
				СТовары.Количество			= Списать;
				сТовары.СтрокаОрдера		= НайденнаяСтрока.НомерСтроки;
				сТовары.КоличествоКодовОСУ  = Окр(сТовары.КоличествоКодовОСУ * Списать / ?(сТовары.КоличествоКодовОСУ=0,1,сТовары.КоличествоКодовОСУ),0);
				
				
				РассчитатьСуммуСтрокиТЧ(сТовары,оЗаказКлиента.ЦенаВключаетНДС);
				
				сТоварыИсходная.КоличествоКодовОСУ		= сТоварыИсходная.КоличествоКодовОСУ - сТовары.КоличествоКодовОСУ;
				сТоварыИсходная.КоличествоУпаковок		= сТоварыИсходная.КоличествоУпаковок - СТовары.КоличествоУпаковок;
				сТоварыИсходная.Количество				= сТоварыИсходная.Количество - СТовары.Количество;
				сТоварыИсходная.СуммаРучнойСкидки		= сТоварыИсходная.СуммаРучнойСкидки - сТовары.СуммаРучнойСкидки;
				НайденнаяСтрока.КоличествоУпаковок		= НайденнаяСтрока.КоличествоУпаковок - (НайденнаяСтрока.КоличествоУпаковок*Списать/НайденнаяСтрока.Количество);
				НайденнаяСтрока.Количество				= НайденнаяСтрока.Количество - Списать;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если НеДостаточноТоваровВОрдере = Истина Тогда
			Сообщение				= Новый СообщениеПользователю;
			Сообщение.Текст			= "В ордере не достаточно товаров для отгрузки. "+ ЗаказКлиента;
			Сообщение.КлючДанных	= ЗаказКлиента;
			Сообщение.Сообщить();
		КонецЕсли;
		СуммаСтарая				= оЗаказКлиента.СуммаДокумента;
		СуммаНовая				= оЗаказКлиента.ПолучитьСуммуЗаказанныхСтрок();
		ДопускРублейНаСтроку	= 5;
		Если СуммаСтарая - СуммаНовая > оЗаказКлиента.Товары.Количество() * ДопускРублейНаСтроку
			или СуммаСтарая - СуммаНовая < - оЗаказКлиента.Товары.Количество() * ДопускРублейНаСтроку Тогда
			ВызватьИсключение(СтрШаблон("Изменение суммы заказа составляет %2, что превышает допустимое значение %1. Операция невозможна.",оЗаказКлиента.Товары.Количество() * ДопускРублейНаСтроку,СуммаСтарая - СуммаНовая ));
		КонецЕсли;
		
		оЗаказКлиента.Записать(?(оЗаказКлиента.Проведен = Истина,РежимЗаписиДокумента.Проведение,РежимЗаписиДокумента.Запись));
		
		Если Не СуммаСтарая = оЗаказКлиента.СуммаДокумента Тогда

			Сообщение				= Новый СообщениеПользователю;
			Сообщение.Текст			= "Изменилась сумма документа. Старая: "+Формат(СуммаСтарая,"")+", новая: "+Формат(оЗаказКлиента.СуммаДокумента)+". "+оЗаказКлиента.Ссылка;
			Сообщение.КлючДанных	= оЗаказКлиента.Ссылка;
			Сообщение.Сообщить();
			ЗаписьЖурналаРегистрации("ДР.ИсправлениеСуммыЗаказа",УровеньЖурналаРегистрации.Информация,,оЗаказКлиента.ССылка,
			СтрШаблон("Отклонение %1, Исходная сумма заказа %2, Новая сумма заказа %3",СуммаСтарая - СуммаНовая, СуммаСтарая, СуммаНовая));
		КонецЕсли;
		
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуСтрокиТЧ(СТовары,ЦенаВключаетНДС)
	
	СТовары.Сумма				= СТовары.Цена * сТовары.КоличествоУпаковок;

	Если СТовары.Сумма = 0 Тогда
		
		сТовары.ПроцентРучнойСкидки	= 0;
		
	Иначе
		
		сТовары.ПроцентРучнойСкидки	= Окр(СТовары.СуммаРучнойСкидки /СТовары.Сумма * 100,2);
		
	КонецЕсли;
	
	сТовары.Сумма				= СТовары.Сумма - СТовары.СуммаРучнойСкидки;
	СтавкаНДС					= УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(сТовары.СтавкаНДС,Ложь);
	
	Если ЦенаВключаетНДС Тогда
		
		сТовары.СуммаСНДС		= сТовары.Сумма;
		сТовары.СуммаНДС		= Окр(сТовары.Сумма * СтавкаНДС / (100+СтавкаНДС) ,2);
		
	Иначе
		
		сТовары.СуммаНДС		= Окр(сТовары.Сумма * СтавкаНДС /100 ,2);
		сТовары.СуммаСНДС		= сТовары.Сумма + сТовары.СуммаНДС;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОбъектыДляОбработки(ОбъектыНазначения)
	
	Результат = Новый Массив;
	Для Каждого ОбъектНазначения из ОбъектыНазначения Цикл
		
		Результат.Добавить(ОбъектНазначения);
		
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ИсправитьРеализациюНаСервере(РеализацияОбъект,Ошибка)

	Запрос			= Новый Запрос;
	Запрос.УстановитьПараметр("Распоряжение",РеализацияОбъект.ЗаказКлиента);
	Запрос.Текст	= "ВЫБРАТЬ
	            	  |	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка КАК Ордер
	            	  |ПОМЕСТИТЬ Ордера
	            	  |ИЗ
	            	  |	Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
	            	  |ГДЕ
	            	  |	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение = &Распоряжение
	            	  |	И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка.Проведен = ИСТИНА
	            	  |
	            	  |СГРУППИРОВАТЬ ПО
	            	  |	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка
	            	  |
	            	  |ИМЕЮЩИЕ
	            	  |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка) = 1
	            	  |;
	            	  |
	            	  |////////////////////////////////////////////////////////////////////////////////
	            	  |ВЫБРАТЬ
	            	  |	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка КАК Ссылка
	            	  |ПОМЕСТИТЬ ОтобранныеОрдера
	            	  |ИЗ
	            	  |	Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
	            	  |ГДЕ
	            	  |	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка В
	            	  |			(ВЫБРАТЬ
	            	  |				Ордера.Ордер КАК Ордер
	            	  |			ИЗ
	            	  |				Ордера КАК Ордера)
	            	  |
	            	  |СГРУППИРОВАТЬ ПО
	            	  |	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка
	            	  |
	            	  |ИМЕЮЩИЕ
	            	  |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение) = 1
	            	  |;
	            	  |
	            	  |////////////////////////////////////////////////////////////////////////////////
	            	  |ВЫБРАТЬ
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.Ссылка КАК Ссылка,
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.НомерСтроки КАК НомерСтроки,
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура КАК Номенклатура,
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.Характеристика КАК Характеристика,
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.Назначение КАК Назначение,
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия КАК Серия,
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.СтатусУказанияСерий КАК СтатусУказанияСерий,
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.ЭтоУпаковочныйЛист КАК ЭтоУпаковочныйЛист,
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.ЭтоСлужебнаяСтрокаПустогоУпаковочногоЛиста КАК ЭтоСлужебнаяСтрокаПустогоУпаковочногоЛиста,
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.УпаковочныйЛистРодитель КАК УпаковочныйЛистРодитель,
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.УпаковочныйЛист КАК УпаковочныйЛист,
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.Упаковка КАК Упаковка,
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.Количество КАК Количество,
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.Действие КАК Действие,
	            	  |	ЗаказКлиентаТовары.КоличествоКодовОСУ КАК КоличествоКодовОСУ
	            	  |ИЗ
	            	  |	Документ.РасходныйОрдерНаТовары.ОтгружаемыеТовары КАК РасходныйОрдерНаТоварыОтгружаемыеТовары
	            	  |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	            	  |		ПО РасходныйОрдерНаТоварыОтгружаемыеТовары.НомерСтроки = ЗаказКлиентаТовары.СтрокаОрдера
	            	  |			И (&Распоряжение = ЗаказКлиентаТовары.Ссылка)
	            	  |ГДЕ
	            	  |	РасходныйОрдерНаТоварыОтгружаемыеТовары.Ссылка В
	            	  |			(ВЫБРАТЬ
	            	  |				ОтобранныеОрдера.Ссылка КАК Ссылка
	            	  |			ИЗ
	            	  |				ОтобранныеОрдера КАК ОтобранныеОрдера)";

	ДанныеОрдера = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.Прямой);
	Ошибка = Ложь;

	Для Каждого сТовары из РеализацияОбъект.Товары Цикл
		СтрокиОрдера = ДанныеОрдера.НайтиСтроки(Новый Структура("Номенклатура,Характеристика,Количество",сТовары.Номенклатура,сТовары.Характеристика,сТовары.Количество ));
		Если СтрокиОрдера.Количество() = 0 Тогда

			Ошибки = Истина;
			Прервать;

		Иначе

			сТовары.СтрокаОрдера = СтрокиОрдера[0].НомерСтроки;
			сТовары.КоличествоКодовОСУ = СтрокиОрдера[0].КоличествоКодовОСУ;
			СтрокиОрдера[0].Количество = 0;

		КонецЕсли;

	КонецЦикла;

	Для Каждого Строка из ДанныеОрдера Цикл

		Если Строка.Количество <> 0 Тогда

			Ошибка = Истина;

		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция  ПолучитьМаксимальнуюДатуВыпускаПоЗаказам(ОбъектыНазначения)

	Запрос			= Новый Запрос;
	Запрос.УстановитьПараметр("МассивЗаказов",ОбъектыНазначения);
	Запрос.Текст	= "ВЫБРАТЬ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка КАК Ссылка,
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение КАК Распоряжение
	|ПОМЕСТИТЬ ОрдераСОснованиями
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
	|ГДЕ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение В(&МассивЗаказов)
	|	И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка.ПометкаУдаления = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка,
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОрдераСОснованиями.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ УсловиеВОдномОрдереОдинЗаказ
	|ИЗ
	|	ОрдераСОснованиями КАК ОрдераСОснованиями
	|
	|СГРУППИРОВАТЬ ПО
	|	ОрдераСОснованиями.Ссылка
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОрдераСОснованиями.Распоряжение) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОрдераСОснованиями.Распоряжение КАК Распоряжение
	|ПОМЕСТИТЬ УсловиеОдинЗаказОдинОрдер
	|ИЗ
	|	ОрдераСОснованиями КАК ОрдераСОснованиями
	|
	|СГРУППИРОВАТЬ ПО
	|	ОрдераСОснованиями.Распоряжение
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОрдераСОснованиями.Ссылка) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Распоряжение КАК ЗаказКлиента,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия КАК Серия,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура.СрокГодности КАК СрокГодности,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура.ЕдиницаИзмеренияСрокаГодности КАК ЕдиницаИзмеренияСрокаГодности,
	|	ЕСТЬNULL(РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия.ГоденДо, ДАТАВРЕМЯ(2050, 1, 1)) КАК ГоденДо,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура КАК Номенклатура
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОрдераСОснованиями.Ссылка КАК Ссылка,
	|		ОрдераСОснованиями.Распоряжение КАК Распоряжение
	|	ИЗ
	|		ОрдераСОснованиями КАК ОрдераСОснованиями
	|	ГДЕ
	|		ОрдераСОснованиями.Ссылка В
	|				(ВЫБРАТЬ
	|					УсловиеВОдномОрдереОдинЗаказ.Ссылка КАК Ссылка
	|				ИЗ
	|					УсловиеВОдномОрдереОдинЗаказ КАК УсловиеВОдномОрдереОдинЗаказ)
	|		И ОрдераСОснованиями.Распоряжение В
	|				(ВЫБРАТЬ
	|					УсловиеОдинЗаказОдинОрдер.Распоряжение КАК Распоряжение
	|				ИЗ
	|					УсловиеОдинЗаказОдинОрдер КАК УсловиеОдинЗаказОдинОрдер)) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдерНаТовары.ОтгружаемыеТовары КАК РасходныйОрдерНаТоварыОтгружаемыеТовары
	|		ПО ВложенныйЗапрос.Ссылка = РасходныйОрдерНаТоварыОтгружаемыеТовары.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Распоряжение,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура.ЕдиницаИзмеренияСрокаГодности,
	|	ЕСТЬNULL(РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия.ГоденДо, ДАТАВРЕМЯ(2050, 1, 1)),
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура.СрокГодности,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура";

	ДанныеОрдеров				= Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.Прямой);
	сМаксимальнаяДатаВыпуска	= Новый Соответствие;

	Для Каждого ЗаказКлиента из ОбъектыНазначения Цикл

		МаксимальнаяДатаВыпуска	= '00010101';
		НайденнаяНоменклатура	= Справочники.Номенклатура.ПустаяСсылка();
		ГоденДо					= '00010101';
		НайденныеСтроки			= ДанныеОрдеров.НайтиСтроки(Новый Структура("ЗаказКлиента",ЗаказКлиента));

		Если НайденныеСтроки.Количество() = 0 Тогда
			
			Сообщение				= Новый СообщениеПользователю;
			Сообщение.Текст			= СтрШаблон("Для заказа клиента %1 не найден расходный ордер",ЗаказКлиента);
			Сообщение.КлючДанных	= ЗаказКлиента;
			Сообщение.Сообщить();
			Продолжить;
			
		КонецЕсли;

		ДанныеОрдера = ДанныеОрдеров.Скопировать(НайденныеСтроки);
		
		Для Каждого с из ДанныеОрдера Цикл
			
			Если с.ГоденДо < '20500101' Тогда

				ДатаВыпуска = РассчитатьДатуВыпуска(с.ГоденДо,с.СрокГодности,с.ЕдиницаИзмеренияСрокаГодности);

				Если ДатаВыпуска > МаксимальнаяДатаВыпуска Тогда

					МаксимальнаяДатаВыпуска	= ДатаВыпуска;
					НайденнаяНоменклатура	= с.Номенклатура;
					ГоденДо					= с.ГоденДо;

				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;

		сМаксимальнаяДатаВыпуска.Вставить(ЗаказКлиента,Новый Структура ("МаксимальнаяДатаВыпуска,Номенклатура,ГоденДО",МаксимальнаяДатаВыпуска,НайденнаяНоменклатура,ГоденДо));
		
	КонецЦикла;

	Возврат сМаксимальнаяДатаВыпуска;

КонецФункции

&НаКлиенте
Процедура СоздатьДокументыРТУ(ОбъектыНазначения,СогласенСНекорректнымиЦенами=Ложь,Закрывать)
	// сначала исправим заказы по ордерам
	сМаксимальнаяДатаВыпуска	= Неопределено;
	ОбъектыДляОбработки			= ПолучитьОбъектыДляОбработки(ОбъектыНазначения);
	ИсправитьЗаказыПоОрдерам(ОбъектыДляОбработки);
	сМаксимальнаяДатаВыпуска	= ПолучитьМаксимальнуюДатуВыпускаПоЗаказам(ОбъектыНазначения);
	
	Для Каждого Элемент из ОбъектыНазначения Цикл

		М = Новый Массив;
		М.Добавить(Элемент);
		ДатаРеализации			= ПолучитьДатуОтгрузкиНаСервере(Элемент)-86400;
		МаксимальнаяДатаВыпуска	= сМаксимальнаяДатаВыпуска[Элемент].МаксимальнаяДатаВыпуска;
		Если МаксимальнаяДатаВыпуска > ДатаРеализации Тогда

			ТекстОшибки = ТекстОшибки +"Нельзя создать реализацию есть товары у которых дата выпуска меньше даты реализации. Заказ: "+Элемент+"
			|"+сМаксимальнаяДатаВыпуска[Элемент].ГоденДо+"//"+сМаксимальнаяДатаВыпуска[Элемент].Номенклатура+Символы.ПС;
			Элементы.ТекстОшибки.Видимость								= Истина;
			Элементы.ФормаПодверждаюПравильностьЦенВДокументе.Видимость	= Ложь;
			Закрывать													= Ложь;

			Продолжить;

		КонецЕсли;

		ПараметрыОткрытия	= СозданиеНаОснованииУТВызовСервера.РеализацияТоваровУслугПараметрыОткрытияФормы(М);
		ПараметрыОткрытия.Основание.РеквизитыШапки.Вставить("Дата",ДатаРеализации);
		ФормаДокумента		= ПолучитьФорму(
		"Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента",
		ПараметрыОткрытия);
		ФормаДокумента.Открыть();
		
		Если Не ОбъектыДляОбработки.Найти(Элемент) = Неопределено Тогда

			РеализацияОбъект	= ФормаДокумента.Объект;
			Ошибка				= Ложь;
			ИсправитьРеализациюНаСервере(РеализацияОбъект,Ошибка);
			
			Если Ошибка = Истина Тогда
				Сообщение			= Новый СообщениеПользователю;
				Сообщение.Текст		= "Ошибка, не удалось привязать строки реализации к ордеру";
				Сообщение.ИдентификаторНазначения = ФормаДокумента.УникальныйИдентификатор;
				Сообщение.Сообщить();
				ФормаДокумента.объект.Комментарий = "Ошибка, не удалось привязать строки реализации к ордеру";
			Иначе
				
				КопироватьДанныеФормы(РеализацияОбъект,ФормаДокумента.Объект);

			КонецЕсли;
		КонецЕсли;

		Если СогласенСНекорректнымиЦенами = Истина Тогда

			ФормаДокумента.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
			ЗаполнитьДополнительныйРеквизит(ФормаДокумента.Объект.Ссылка);
			ФормаДокумента.Прочитать();

		КонецЕсли;
		
		ФормаДокумента.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
		СоздатьСФИТТН(ФормаДокумента.Объект.Ссылка,Элемент);
		ФормаДокумента.Прочитать();

	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьДополнительныйРеквизит(СсылкаНаРТУ)
	
	ДокументОбъект			= СсылкаНаРТУ.ПолучитьОбъект();
	ДополнительныйРеквизит	= СсылкаНаРеквизитПодтверждаюЦены();
	Строка = ДокументОбъект.ДополнительныеРеквизиты.Найти(ДополнительныйРеквизит,"Свойство");
	Если Строка=Неопределено Тогда

		Строка				= ДокументОбъект.ДополнительныеРеквизиты.Добавить();
		Строка.Свойство		= ДополнительныйРеквизит;

	КонецЕсли;

	Строка.Значение			= Истина;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьСФИТТН(Ссылка,Заказ)
	оСчетФактураВыданный					= Документы.СчетФактураВыданный.СоздатьДокумент();
	оСчетФактураВыданный.Заполнить(Новый Структура("ДокументОснование",Ссылка ));
	оСчетФактураВыданный.Дата				= Ссылка.Дата;
	оСчетФактураВыданный.ДатаВыставления	= Ссылка.Дата;
	оСчетФактураВыданный.Записать(РежимЗаписиДокумента.Проведение);
	// проверить дату счета фактуры
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",оСчетФактураВыданный.Организация);
	Запрос.УстановитьПараметр("Дата", КонецДня(оСчетФактураВыданный.Дата));
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	СчетФактураВыданный.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.Организация = &Организация
	|	И СчетФактураВыданный.Дата > &Дата";

	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой);

	Если Выборка.Следующий() Тогда

		Сообщить("Введен счет фактура, дата которого меньше существующих документов. Проверьте нумерацию счетов фактур");

	КонецЕсли;
	
	Если Не Заказ.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз Тогда
		М			= Новый Массив;
		м.Добавить(Ссылка);
		МассивТН	= СоздатьТранспортныеНакладные(М,оСчетФактураВыданный.Ссылка);
	КонецЕсли;
	
КонецПроцедуры


