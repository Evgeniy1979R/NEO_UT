Процедура ЗаполнитьАдресаНаСервере()
	
	СписокАдресов.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Партнеры.ДополнительныеРеквизиты КАК ПартнерыДополнительныеРеквизиты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
	|		ПО ПартнерыДополнительныеРеквизиты.Ссылка = Партнеры.Ссылка
	|			И (ПартнерыДополнительныеРеквизиты.Свойство = &Свойство)
	|			И (ПартнерыДополнительныеРеквизиты.Значение = &Значение)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО (Контрагенты.Партнер = Партнеры.Ссылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	
	Запрос.УстановитьПараметр("Значение", Истина);
	Запрос.УстановитьПараметр("Свойство", ПолучитьСвойство("ВыгружатьАдресДоставки_7bd43ca5ecb44ef6b279b4370c078f48"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СписокАдресов.Добавить(ВыборкаДетальныеЗаписи.Ссылка,ВыборкаДетальныеЗаписи.Наименование);// + " (" + ВыборкаДетальныеЗаписи.ИНН + ")");
	КонецЦикла;
	
