	Возврат ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(ПрефиксацияОбъектовКлиентСервер.УдалитьПрефиксыИзНомераОбъекта(ВхНомер,Истина,Истина));
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьПоступленияПослеВводаДат(Результат,ДополнительныеПараметры) Экспорт 
	
	Если ТипЗнч(Результат) = Тип("Структура") и Результат.Действие = "ОК" Тогда 
		
		АдресВоВременномХранилище = ВыгрузитьПоступленияНаСервере(Результат.Адрес); 
		
		ИмяФайла = СтрШаблон("%1\%2_%3_transfer.xml", 
		КаталогВыгрузки,
		Формат(ТекущаяДата(),"ДФ=yyyyMMdd"),
		Формат(НомерФайлаПоступлений,"ЧЦ=4; ЧДЦ=0; ЧВН=; ЧГ=0"));
		
		ПолучениеЗавершено = Новый ОписаниеОповещения("ПолучениеПоступленийЗавершено",ЭтаФорма);
		НачатьПолучениеФайлаССервера(ПолучениеЗавершено,АдресВоВременномХранилище, ИмяФайла );
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеПоступленийЗавершено(ПолученныйФайл, ДополнительныеПараметры) экспорт
	Сооб = Новый СообщениеПользователю() ;
	Сооб.Текст = "Файл " + ПолученныйФайл.ПолноеИмя + " записан";
	Сооб.Сообщить();
КонецПроцедуры

&НаСервере
Функция ВыгрузитьПоступленияНаСервере(Адрес)     
	ДеревоДатВыпуска = ПолучитьИзВременногоХранилища(Адрес);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПриобретениеТоваровУслуг.Ссылка КАК Ссылка,
	|	ПриобретениеТоваровУслуг.Организация КАК Организация,
	|	ПРЕДСТАВЛЕНИЕ(ПриобретениеТоваровУслуг.Ссылка) КАК РеализацияПредставление,
	|	ПриобретениеТоваровУслуг.Номер КАК Номер,
	|	ПриобретениеТоваровУслуг.Дата КАК Дата,
	|	ПриобретениеТоваровУслуг.Контрагент КАК Контрагент,
	|	ПриобретениеТоваровУслуг.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	|ГДЕ
	|	ПриобретениеТоваровУслуг.Ссылка В(&СписокПоступлений)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УпаковкиЕдиницыИзмерения.Ссылка КАК Ссылка,
	|	УпаковкиЕдиницыИзмерения.Владелец КАК Номенклатура,
	|	МИНИМУМ(УпаковкиЕдиницыИзмерения.Числитель / ВЫБОР
	|			КОГДА УпаковкиЕдиницыИзмерения.Знаменатель = 0
	|				ТОГДА 1
	|			ИНАЧЕ УпаковкиЕдиницыИзмерения.Знаменатель
	|		КОНЕЦ) КАК Числитель
	|ПОМЕСТИТЬ вт_Упаковки
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|		ПО ПриобретениеТоваровУслугТовары.Номенклатура = УпаковкиЕдиницыИзмерения.Владелец
	|			И (ПриобретениеТоваровУслугТовары.Ссылка В (&СписокПоступлений))
	|ГДЕ
	|	УпаковкиЕдиницыИзмерения.Родитель = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	УпаковкиЕдиницыИзмерения.Ссылка,
	|	УпаковкиЕдиницыИзмерения.Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПриобретениеТоваровУслугТовары.Ссылка КАК Ссылка,
	|	ПриобретениеТоваровУслугТовары.НомерСтроки КАК НомерСтроки,
	|	СпрНоменклатура.Код КАК НоменклатураКод,
	|	СпрНоменклатура.НаименованиеПолное КАК НоменклатураНаименованиеПолное,
	|	СпрНоменклатура.Производитель КАК Производитель,
	|	ПриобретениеТоваровУслугТовары.СтавкаНДС КАК СтавкаНДС,
	|	ПриобретениеТоваровУслугТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ПриобретениеТоваровУслугТовары.Количество КАК Количество,
	|	ПриобретениеТоваровУслугТовары.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА ПриобретениеТоваровУслугТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА СпрНоменклатура.ЕдиницаИзмерения
	|		ИНАЧЕ ПриобретениеТоваровУслугТовары.Упаковка
	|	КОНЕЦ КАК ПроверкаУпаковки,
	|	СпрНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СпрНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмеренияНаименование,
	|	ПриобретениеТоваровУслугТовары.Цена КАК Цена,
	|	ПриобретениеТоваровУслугТовары.СуммаНДС КАК СуммаНДС,
	|	ПриобретениеТоваровУслугТовары.СуммаСНДС КАК СуммаСНДС,
	|	ЕСТЬNULL(Упаковки.Наименование, """") КАК УпаковкиНаименование,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Наименование, """") КАК НоменклатураЕдиницыИзмеренияНаименование,
	|	СпрНоменклатура.ВесЧислитель / ВЫБОР
	|		КОГДА СпрНоменклатура.ВесЗнаменатель = 0
	|			ТОГДА 1
	|		ИНАЧЕ СпрНоменклатура.ВесЗнаменатель
	|	КОНЕЦ КАК Вес,
	|	СпрНоменклатура.ВесБрутто КАК ВесБрутто,
	|	ЕСТЬNULL(вт_Упаковки.Числитель, 1) КАК МинимальнаяКоробка,
	|	ПриобретениеТоваровУслугТовары.Номенклатура КАК Номенклатура,
	|	СпрНоменклатура.ЕдиницаИзмерения.Код КАК НоменклатураЕдиницаИзмеренияКод,
	|	СпрНоменклатура.Наименование КАК НоменклатураНаименование,
	|	СпрНоменклатура.СрокГодности КАК НоменклатураСрокГодности,
	|	СпрНоменклатура.ЕдиницаИзмеренияСрокаГодности КАК НоменклатураЕдиницаИзмеренияСрокаГодности,
	|	ВЫБОР
	|		КОГДА ПриобретениеТоваровУслугТовары.Упаковка.Числитель ЕСТЬ NULL
	|			ТОГДА 1
	|		ИНАЧЕ ПриобретениеТоваровУслугТовары.Упаковка.Числитель / ВЫБОР
	|				КОГДА ПриобретениеТоваровУслугТовары.Упаковка.Знаменатель = 0
	|					ТОГДА 1
	|			КОНЕЦ
	|	КОНЕЦ КАК УпаковкаКоэффициент,
	|	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Упаковка.ЕдиницаИзмерения.Код, ПриобретениеТоваровУслугТовары.Номенклатура.ЕдиницаИзмерения.Код) КАК УпаковкаЕдиницаКод,
	|	ПриобретениеТоваровУслугТовары.Номенклатура.СтавкаНДС КАК НоменклатураСтавкаНДС
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК Упаковки
	|		ПО ПриобретениеТоваровУслугТовары.Упаковка = Упаковки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ПриобретениеТоваровУслугТовары.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|		ПО (СпрНоменклатура.ЕдиницаИзмерения = УпаковкиЕдиницыИзмерения.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ вт_Упаковки КАК вт_Упаковки
	|		ПО (вт_Упаковки.Номенклатура = СпрНоменклатура.Ссылка)
	|ГДЕ
	|	ПриобретениеТоваровУслугТовары.Ссылка В(&СписокПоступлений)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриобретениеТоваровУслугТовары.Ссылка,
	|	ПриобретениеТоваровУслугТовары.НомерСтроки";
	
	
	
	Запрос.УстановитьПараметр("СписокПоступлений", СписокПоступлений.ВыгрузитьЗначения());	
	РезультатЗапроса	= Запрос.ВыполнитьПакет();
	ВыборкаДокументы	= РезультатЗапроса[0].Выбрать();
	ВыборкаТовары		= РезультатЗапроса[2].Выбрать();
	
	СтильЭкспоXSD = РеквизитФормыВЗначение("Объект").ПолучитьМакет("СтильЭкспоXSD");
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	СтильЭкспоXSD.Записать(ИмяВременногоФайла);
	МассивФайловСхем = Новый Массив;
	МассивФайловСхем.Добавить(ИмяВременногоФайла);
	Фабрика = СоздатьФабрикуXDTO(МассивФайловСхем);
	ТипФайл = Фабрика.Тип("https://StyleExpo","Файл");
	ТипДокумент = Фабрика.Тип("https://StyleExpo","ДокументТип");
	ГрузополучательТип = Фабрика.Тип("https://StyleExpo","ГрузополучательТип");
	ОснованиеТип = Фабрика.Тип("https://StyleExpo","ОснованиеТип");
	ТоварыТип	= Фабрика.Тип("https://StyleExpo","ТоварыТип");
	СтрокаТовараТип = Фабрика.Тип("https://StyleExpo","СтрокаТовараТип");
	УпаковкаТип = Фабрика.Тип("https://StyleExpo","УпаковкаТип");
	КарточкаТовараТип = Фабрика.Тип("https://StyleExpo","КарточкаТовараТип");
	УпаковкаТип			= Фабрика.Тип("https://StyleExpo","УпаковкаТип");
	Файл = Фабрика.Создать(ТипФайл);
	Файл.ВерсияФормата = "1.0";
	
	Пока ВыборкаДокументы.Следующий() Цикл
		сДатыВыпуска = ДеревоДатВыпуска.Строки.Найти(ВыборкаДокументы.Ссылка,"ДокументПоступления",Ложь);
		
		Документ = Фабрика.Создать(ТипДокумент);
		Файл.Документ.Добавить(Документ);
		Документ.ТипДокумента = ТипДокумента_Поставка();
		Документ.ДатаДокумента = ВыборкаДокументы.Дата;
		
		оГрузополучатель = Фабрика.Создать(ГрузополучательТип);
		ЗаполнитьОГрузополучатель(оГрузополучатель,ВыборкаДокументы.Организация);
		Документ.Заказчик = оГрузополучатель; 
		оОснование = Фабрика.Создать(ОснованиеТип);
		оОснование.Наименование = ""+ВыборкаДокументы.Ссылка;
		оОснование.Номер = ВыборкаДокументы.Номер;
		оОснование.Дата = ВыборкаДокументы.Дата;
		Документ.Основание = оОснование;
		Документ.ТемпературныйРежим = ТемпературныйРежим_ЗамороженнаяПродукция();
		Документ.Комментарий = "";
		оТовары = Фабрика.Создать(ТоварыТип);
		Документ.Товары = оТовары;
		СтруктураПоиска = Новый Структура("Ссылка");
		СтруктураПоиска.Ссылка = ВыборкаДокументы.Ссылка;
		Пока ВыборкаТовары.НайтиСледующий(СтруктураПоиска) Цикл
			оСтрока = Фабрика.Создать(СтрокаТовараТип);
			оТовары.Строка.Добавить(оСтрока);
			оТовар  = Фабрика.Создать(КарточкаТовараТип);
			оСтрока.НомерСтроки = ВыборкаТовары.НомерСтроки;
			оТовар.Артикул = ВыборкаТовары.НоменклатураКод;
			оТовар.Идентификатор = XMLСтрока(ВыборкаТовары.Номенклатура.УникальныйИдентификатор());
			оТовар.Наименование	 = ВыборкаТовары.НоменклатураНаименование;
			оТовар.КодЕдиницыИзмерения = ВыборкаТовары.НоменклатураЕдиницаИзмеренияКод;
			оТовар.СрокГодности		= СрокГодностиВДнях(ВыборкаТовары.НоменклатураСрокГодности,ВыборкаТовары.НоменклатураЕдиницаИзмеренияСрокаГодности);;
			оСтрока.Товар = оТовар;
			оУпаковка = Фабрика.Создать(УпаковкаТип);
			оУпаковка.КоличествоВУпаковке =  ВыборкаТовары.УпаковкаКоэффициент;
			оУпаковка.КодЕдиницыИзмерения =  ВыборкаТовары.УпаковкаЕдиницаКод;
			оСтрока.Упаковка = оУпаковка;
			ЗначениеДатыВыпуска = '00010101';
			Если сДатыВыпуска <> Неопределено Тогда 
				сДатаВыпускаСтрока = сДатыВыпуска.Строки.Найти(ВыборкаТовары.НомерСтроки,"НомерСтроки",Ложь);
				Если сДатаВыпускаСтрока <> Неопределено Тогда
					ЗначениеДатыВыпуска = сДатаВыпускаСтрока.ДатаВыпуска;
				КонецЕсли;
			КонецЕсли;			
			оСтрока.ДатаПроизводства = ЗначениеДатыВыпуска;
			оСтрока.ГоденДо = ЗначениеДатыВыпуска + 86400*оТовар.СрокГодности;
			оСтрока.Количество = ВыборкаТовары.Количество;
			оСтрока.КоличествоУпаковок = ВыборкаТовары.КоличествоУпаковок;
			оСтрока.Цена = Окр(ВыборкаТовары.СуммаСНДС/ВыборкаТовары.КоличествоУпаковок,2);
			острока.СтавкаНДС = ПреобразоватьСтавкуНДС(ВыборкаТовары.НоменклатураСтавкаНДС);
			
			
			//Поток.ДобавитьСтроку("<Line>");
			
			//ЗаписатьОдноЗначение(Поток,	"LineNumber", 		ВыборкаТовары.НомерСтроки, 								"(номер строки)");
			//ЗаписатьОдноЗначение(Поток,	"ItemID",			ПредставлениеGUID(ВыборкаТовары.Номенклатура),			"(GUID из файла с номенклатурой)");
			//ЗаписатьОдноЗначение(Поток,	"BuyerItemCode",	СокрЛП(ВыборкаТовары.НоменклатураКод),			 		"(CODE из файла с номенклатурой)");
			//ЗаписатьОдноЗначение(Поток,	"ItemDescription",	СокрЛП(ВыборкаТовары.НоменклатураНаименованиеПолное),	"(NAME из файла с номенклатурой)");
			//ЗаписатьОдноЗначение(Поток,	"UNIT",				СокрЛП(ВыборкаТовары.ЕдиницаИзмеренияНаименование),		"(базовая единица из файла с номенклатурой)"); 
			//ЗаписатьОдноЗначение(Поток,	"UNITWEIGTH",		Формат(ВыборкаТовары.Вес,"ЧДЦ=3; ЧРД=.; ЧГ=0"),"(вес базовой единицы из файла с номенклатурой)"); 
			//ЗаписатьОдноЗначение(Поток,	"Quantity", 		Формат(ВыборкаТовары.КоличествоУпаковок,"ЧДЦ=0; ЧРД=.; ЧГ=0") ,"(Количество единиц товара) используются только единицы указанные в файле с номенклатурой");
			//ЗаписатьОдноЗначение(Поток,	"BoxQuantity",		Формат(ВыборкаТовары.КоличествоУпаковок/ВыборкаТовары.МинимальнаяКоробка,"ЧДЦ=0; ЧРД=.; ЧГ=0"));
			//ЗаписатьОдноЗначение(Поток,	"MFR", 				СокрЛП(ВыборкаТовары.Производитель),					"(изготовитель)");
			
			//
			//ЗаписатьОдноЗначение(Поток,"ProductionDate",	Формат(ЗначениеДатыВыпуска,"ДФ=dd.MM.yyyy"),			"(Дата выработки)");
			//
			//Поток.ДобавитьСтроку("</Line>");
		КонецЦикла;
		
		//Поток.ДобавитьСтроку("</Transfer-Lines>");
		ВыборкаТовары.Сбросить();
		
		//Поток.ДобавитьСтроку("</Transfer>");
	КонецЦикла;
	//ЗаписатьОдноЗначение(Поток,Имя,Значение, Знач Комментарий = "")
	
	//Поток.ДобавитьСтроку("</Document-Transfer>");
	//файл = ПолучитьИмяВременногоФайла("xml");
	//Поток.Записать(файл);
	ЗаписьXML = Новый ЗаписьXML;
	ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML("windows-1251","1.0",Истина,Истина,Символы.Таб);
	ЗаписьXML.УстановитьСтроку(ПараметрыЗаписиXML);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	Фабрика.ЗаписатьXML(ЗаписьXML, Файл);
	XmlСтрокой = ЗаписьXML.Закрыть();
	XmlСтрокой = СтрЗаменить(XmlСтрокой ,Символы.ПС,Символы.ВК+Символы.ПС);
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(XmlСтрокой,"windows-1251");	
	Возврат поместитьВоВременноеХранилище(ДвоичныеДанные);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОГрузополучатель(оГрузополучатель,КонтрагентОрганизация,ЗаполнятьАдрес = Ложь, оАдрес = Неопределено,ЗначениеАдреса = "")
	оГрузополучатель.Наименование = КонтрагентОрганизация.Наименование;
	оГрузополучатель.ИНН		  = КонтрагентОрганизация.ИНН;
	оГрузополучатель.КПП			= КонтрагентОрганизация.КПП;
	оГрузополучатель.Идентификатор	= XMLСтрока(КонтрагентОрганизация.УникальныйИдентификатор());
	Если ЗаполнятьАдрес = Истина Тогда 
		МассивАдресов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗначениеАдреса);
		сАдрес = РаботаСАдресами.СведенияОбАдресах(МассивАдресов)[0];
		оАдрес.Индекс		= сАдрес.Индекс;
		оАдрес.КодРегиона	= сАдрес.КодРегиона; 
		оАдрес.Район	    = сАдрес.Район;
		// Москва является регионом, а город в этом случае остается пустым
		Если сАдрес.Город = "" Тогда 
			оАдрес.Город	    = сАдрес.Регион;
		Иначе
			
			оАдрес.Город	    = сАдрес.Город;
		КонецЕсли;
		оАдрес.НаселПункт	= сАдрес.НаселенныйПункт;		
		оАдрес.Улица	    = сАдрес.Улица;
		стмп =  Новый Структура("Номер,ТипЗдания","","");
		ЗаполнитьЗначенияСвойств(стмп,сАдрес.Здание);
		оАдрес.Дом	        = стмп.Номер;
		стмп = Новый Структура("Номер","" );
		
		Если ТипЗнч(сАдрес.Корпуса) = Тип("Массив") Тогда
			ЗаполнитьЗначенияСвойств(стмп,сАдрес.Корпуса[0]);
		КонецЕсли;
		
		оАдрес.Корпус	    = стмп.Номер;
		оАдрес.Квартира	    = "";
		оАдрес.ИныеСвед	    = сАдрес.Представление;
		оГрузополучатель.Адрес = оАдрес;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
//Устарело
Процедура ДобавитьРеализацию(Поток, ОднаРеализация)
	
	Поток.ДобавитьСтроку("<Order>");
	Поток.ДобавитьСтроку("<Order-Header>"); 
	ЗаписатьОдноЗначение(Поток,"DocNumber",		СокрЛП("НОП0000000"+ПодготовитьНомер(ОднаРеализация.СФНомер))); 
	ЗаписатьОдноЗначение(Поток,"OrderNumber",	СокрЛП(ОднаРеализация.ЗаказНомерПоДаннымКлиента)); 
	ЗаписатьОдноЗначение(Поток,"SellNumber",	СокрЛП("НОП0000000"+ПодготовитьНомер(ОднаРеализация.СФНомер))); 
	ЗаписатьОдноЗначение(Поток,"CountNumber",	СокрЛП("НОП0000000"+ПодготовитьНомер(ОднаРеализация.СФНомер))); 
	ЗаписатьОдноЗначение(Поток,"OrderDate",		Формат(ОднаРеализация.ДатаСФ,"ДФ=dd.MM.yyyy"));
	ЗаписатьОдноЗначение(Поток,"ShipmentDate",	Формат(ОднаРеализация.ЖелаемаяДатаДоставкиДоКлиента,"ДФ=dd.MM.yyyy"));  
	ЗаписатьОдноЗначение(Поток,"Buyer",			ПредставлениеGUID(ОднаРеализация.Контрагент));
	ЗаписатьОдноЗначение(Поток,"Contract",		СокрЛП(ОднаРеализация.ДоговорНаименование));
	ЗаписатьОдноЗначение(Поток,"DeliveryPoint",	ПредставлениеGUID(ОднаРеализация.Грузополучатель));
	ЗаписатьОдноЗначение(Поток,"COOLED",		"0");
	ЗаписатьОдноЗначение(Поток,"SelfDelivery",	?(ОднаРеализация.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз,"1","0"));
	ЗаписатьОдноЗначение(Поток,"Comment",		"");
	Поток.ДобавитьСтроку("</Order-Header>"); 
	Поток.ДобавитьСтроку("<Order-Lines>");   
	LineNumber = 1;
	Для каждого СтрокаТовара из ОднаРеализация.Товары цикл
		Поток.ДобавитьСтроку("<Line>"); 
		ЗаписатьОдноЗначение(Поток,"LineNumber",		Формат(LineNumber,"ЧДЦ=0; ЧГ=0"));
		ЗаписатьОдноЗначение(Поток,"ItemID",			ПредставлениеGUID(СтрокаТовара.Номенклатура));
		ЗаписатьОдноЗначение(Поток,"BuyerItemCode",		СокрЛП(СтрокаТовара.НоменклатураКод));
		ЗаписатьОдноЗначение(Поток,"ItemDescription",	СокрЛП(СтрокаТовара.НоменклатураНаименованиеПолное));
		ЗаписатьОдноЗначение(Поток,"NDS" ,				СтрЗаменить(СтрокаТовара.СтавкаНДС,"%",""));
		Если НЕ СтрокаТовара.ПроверкаУпаковки = СтрокаТовара.НоменклатураЕдиницаИзмерения Тогда
			СообщитьПользователюОбОшибке("В реализации " + СокрЛП(ОднаРеализация.РеализацияПредставление)+ " отгрузка не в базовой единице измерения.");	
		КонецЕсли;
		
		ЗаписатьОдноЗначение(Поток,"UNIT",				СокрЛП(СтрокаТовара.НоменклатураЕдиницыИзмеренияНаименование)); 
		ЗаписатьОдноЗначение(Поток,"UNITWEIGTH",		Формат(СтрокаТовара.ВесЧислитель,"ЧДЦ=3; ЧРД=.; ЧГ=0"));
		ЗаписатьОдноЗначение(Поток,"OrderedQuantity",	Формат(СтрокаТовара.КоличествоУпаковок,"ЧДЦ=0; ЧРД=.; ЧГ=0"));
		ЗаписатьОдноЗначение(Поток,"BoxQuantity",		Формат(СтрокаТовара.КоличествоУпаковок/СтрокаТовара.МинимальнаяКоробка,"ЧДЦ=0; ЧРД=.; ЧГ=0"));
		ЗаписатьОдноЗначение(Поток,"UnitPrice",			Формат(СтрокаТовара.Цена,"ЧДЦ=2; ЧРД=.; ЧГ=0"));
		ЗаписатьОдноЗначение(Поток,"VAT_Amount",		Формат(СтрокаТовара.СуммаНДС,"ЧДЦ=2; ЧРД=.; ЧГ=0"));
		ЗаписатьОдноЗначение(Поток,"Amount",			Формат(СтрокаТовара.СуммаСНДС,"ЧДЦ=2; ЧРД=.; ЧГ=0"));
		ЗаписатьОдноЗначение(Поток,"CCDNumber",			СокрЛП(СтрокаТовара.РегистрационныйНомер));
		ЗаписатьОдноЗначение(Поток,"Country",			СокрЛП(СтрокаТовара.СтранаПроисхождения));
		ЗаписатьОдноЗначение(Поток,"CountryCode",		СокрЛП(СтрокаТовара.СтранаКод));
		Поток.ДобавитьСтроку("</Line>"); 
		LineNumber = LineNumber + 1;
	КонецЦикла;
	Поток.ДобавитьСтроку("</Order-Lines>"); 	
	Поток.ДобавитьСтроку("</Order>");
	
Конецпроцедуры

&НаСервере
//Устарело
Функция ПолучитьСвойство(ИмяСвойства)
	
	Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя",ИмяСвойства);
	
КонецФункции

&НаСервере
//Устарело
Функция ВыгрузитьНоменклатуруНаСервере()
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Группа",СписокГруппНоменклатуры.ВыгрузитьЗначения());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СпрНоменклатура.Родитель КАК Родитель,
	|	СпрНоменклатура.Ссылка КАК Ссылка,
	|	СпрНоменклатура.ВидНоменклатуры КАК ВидНоменклатуры
	|ПОМЕСТИТЬ вр_Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|ГДЕ
	|	НЕ СпрНоменклатура.ЭтоГруппа
	|	И СпрНоменклатура.Ссылка В ИЕРАРХИИ(&Группа)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбластиДействияСертификатовНоменклатуры.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(СертификатыНоменклатуры.ДатаНачалаСрокаДействия) КАК ДатаНачалаСрокаДействия
	|ПОМЕСТИТЬ вт_СамыйМолодойСертификат
	|ИЗ
	|	РегистрСведений.ОбластиДействияСертификатовНоменклатуры КАК ОбластиДействияСертификатовНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СертификатыНоменклатуры КАК СертификатыНоменклатуры
	|		ПО ОбластиДействияСертификатовНоменклатуры.СертификатНоменклатуры = СертификатыНоменклатуры.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вр_Номенклатура КАК вр_Номенклатура
	|		ПО ОбластиДействияСертификатовНоменклатуры.Номенклатура = вр_Номенклатура.Ссылка
	|ГДЕ
	|	ОбластиДействияСертификатовНоменклатуры.Номенклатура = вр_Номенклатура.Ссылка
	|	И СертификатыНоменклатуры.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСертификатовНоменклатуры.Действующий)
	|	И НЕ СертификатыНоменклатуры.ПометкаУдаления
	|	И СертификатыНоменклатуры.ДатаНачалаСрокаДействия <= &ДатаЗапроса
	|	И (СертификатыНоменклатуры.ДатаОкончанияСрокаДействия >= &ДатаЗапроса
	|			ИЛИ СертификатыНоменклатуры.Бессрочный)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОбластиДействияСертификатовНоменклатуры.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбластиДействияСертификатовНоменклатуры.Номенклатура КАК Номенклатура,
	|	СертификатыНоменклатуры.Ссылка КАК Ссылка,
	|	СертификатыНоменклатуры.Номер КАК Номер,
	|	СертификатыНоменклатуры.ОрганВыдавшийДокумент КАК ОрганВыдавшийДокумент,
	|	СертификатыНоменклатуры.ДатаНачалаСрокаДействия КАК ДатаНачалаСрокаДействия,
	|	СертификатыНоменклатуры.ДатаОкончанияСрокаДействия КАК ДатаОкончанияСрокаДействия,
	|	СертификатыНоменклатуры.Бессрочный КАК Бессрочный,
	|	СертификатыНоменклатуры.ТипСертификата КАК ТипСертификата,
	|	СертификатыНоменклатуры.ОрганизацияПринявшаяСертификат КАК ОрганизацияПринявшаяСертификат
	|ПОМЕСТИТЬ вт_Сертификаты
	|ИЗ
	|	вт_СамыйМолодойСертификат КАК СамыйМолодойСертификат
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СертификатыНоменклатуры КАК СертификатыНоменклатуры
	|		ПО СамыйМолодойСертификат.ДатаНачалаСрокаДействия = СертификатыНоменклатуры.ДатаНачалаСрокаДействия
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОбластиДействияСертификатовНоменклатуры КАК ОбластиДействияСертификатовНоменклатуры
	|		ПО (ОбластиДействияСертификатовНоменклатуры.СертификатНоменклатуры = СертификатыНоменклатуры.Ссылка)
	|			И (ОбластиДействияСертификатовНоменклатуры.Номенклатура = СамыйМолодойСертификат.Номенклатура)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	МИНИМУМ(УпаковкиЕдиницыИзмерения.Ссылка) КАК Упаковка,
	|	ВложенныйЗапрос.Коэффициент КАК Коэффициент
	|ПОМЕСТИТЬ ВТ_Упаковки
	|ИЗ
	|	(ВЫБРАТЬ
	|		УпаковкиЕдиницыИзмерения.Владелец КАК Номенклатура,
	|		МИНИМУМ(ВЫБОР
	|				КОГДА УпаковкиЕдиницыИзмерения.Знаменатель = 0
	|					ТОГДА 99999999999
	|				ИНАЧЕ УпаковкиЕдиницыИзмерения.Числитель / УпаковкиЕдиницыИзмерения.Знаменатель
	|			КОНЕЦ) КАК Коэффициент
	|	ИЗ
	|		Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|	ГДЕ
	|		УпаковкиЕдиницыИзмерения.Владелец В
	|				(ВЫБРАТЬ
	|					вр_Номенклатура.Ссылка КАК ссылка
	|				ИЗ
	|					вр_Номенклатура КАК вр_Номенклатура)
	|		И УпаковкиЕдиницыИзмерения.ПометкаУдаления = ЛОЖЬ
	|	
	|	СГРУППИРОВАТЬ ПО
	|		УпаковкиЕдиницыИзмерения.Владелец) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|		ПО ВложенныйЗапрос.Номенклатура = УпаковкиЕдиницыИзмерения.Владелец
	|			И (ЛОЖЬ = УпаковкиЕдиницыИзмерения.ПометкаУдаления)
	|			И (0 <> УпаковкиЕдиницыИзмерения.Знаменатель)
	|			И (ВложенныйЗапрос.Коэффициент = УпаковкиЕдиницыИзмерения.Числитель / УпаковкиЕдиницыИзмерения.Знаменатель)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.Коэффициент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Номенклатура,
	|	НоменклатураДополнительныеРеквизиты.Свойство КАК Свойство,
	|	НоменклатураДополнительныеРеквизиты.Свойство.Имя КАК СвойствоИмя,
	|	МИНИМУМ(НоменклатураДополнительныеРеквизиты.Значение) КАК Значение
	|ПОМЕСТИТЬ ВТ_ДопРеквизитыНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	|ГДЕ
	|	НоменклатураДополнительныеРеквизиты.Ссылка В
	|			(ВЫБРАТЬ
	|				вр_Номенклатура.Ссылка КАК Ссылка
	|			ИЗ
	|				вр_Номенклатура КАК вр_Номенклатура)
	|
	|СГРУППИРОВАТЬ ПО
	|	НоменклатураДополнительныеРеквизиты.Ссылка,
	|	НоменклатураДополнительныеРеквизиты.Свойство,
	|	НоменклатураДополнительныеРеквизиты.Свойство.Имя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вр_Номенклатура.Ссылка КАК Ссылка,
	|	вр_Номенклатура.Ссылка.Код КАК Код,
	|	вр_Номенклатура.Ссылка.Артикул КАК Артикул,
	|	вр_Номенклатура.Ссылка.НаименованиеПолное КАК НаименованиеПолное,
	|	вр_Номенклатура.Ссылка.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	вр_Номенклатура.Ссылка.ЕдиницаИзмерения.Наименование КАК ЕдиницаИзмеренияНаименование,
	|	вр_Номенклатура.Ссылка.СтавкаНДС КАК СтавкаНДС,
	|	вр_Номенклатура.Ссылка.Производитель КАК Производитель,
	|	ВЗ_ШК_СПустойЕдиницей.Штрихкод КАК ШтрихкодБазовой,
	|	вр_Номенклатура.Ссылка.ЕдиницаИзмерения КАК УпаковкаБазовой,
	|	ВЗ_ШК_Упаковок.Штрихкод КАК ШтрихкодУпаковки,
	|	ВТ_Упаковки.Упаковка КАК УпаковкаУпаковки,
	|	ЕСТЬNULL(ВТ_Упаковки.Упаковка.КоличествоУпаковокНаПаллете, 0) КАК КоличествоУпаковокНаПаллете,
	|	ЕСТЬNULL(ВТ_Упаковки.Коэффициент, 0) КАК Коэффициент,
	|	вр_Номенклатура.Ссылка.ВесЗнаменатель КАК ВесЗнаменатель,
	|	вр_Номенклатура.Ссылка.ВесЧислитель КАК ВесЧислитель,
	|	вр_Номенклатура.Ссылка.ВесБрутто КАК ВесБрутто,
	|	Сертификаты.Ссылка КАК СертификатыСсылка,
	|	ЕСТЬNULL(Сертификаты.Номер, """") КАК СертификатыНомер,
	|	ЕСТЬNULL(Сертификаты.ОрганВыдавшийДокумент, """") КАК СертификатыОрганВыдавшийДокумент,
	|	ЕСТЬNULL(Сертификаты.ДатаНачалаСрокаДействия, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК СертификатыДатаНачалаСрокаДействия,
	|	ЕСТЬNULL(Сертификаты.ДатаОкончанияСрокаДействия, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК СертификатыДатаОкончанияСрокаДействия,
	|	ЕСТЬNULL(Сертификаты.Бессрочный, ЛОЖЬ) КАК СертификатыБессрочный,
	|	ЕСТЬNULL(Сертификаты.ТипСертификата, """") КАК СертификатыТипСертификата,
	|	ЕСТЬNULL(Сертификаты.ОрганизацияПринявшаяСертификат, """") КАК СертификатыОрганизацияПринявшаяСертификат,
	|	ЕСТЬNULL(ВТ_ДопРеквизитыНоменклатурыАртАшан.Значение, """") КАК АртикулАшан,
	|	ЕСТЬNULL(ВТ_ДопРеквизитыНоменклатурыАртРеалОкей.СвойствоИмя, """") КАК АртикулРеалОкей,
	|	ЕСТЬNULL(ВТ_ДопРеквизитыНоменклатурыАртГГлобус.Значение, """") КАК АртикулГиперглобус,
	|	ЕСТЬNULL(ВТ_ДопРеквизитыНоменклатурыАртХ5.Значение, """") КАК АртикулХ5,
