	ИмяФайла = КаталогВыгрузки +"\" + Формат(ТекущаяДата(),"ДФ=yyyyMMdd") + "_" + Формат(НомерСохраненияРеализаций,"ЧЦ=4; ЧДЦ=0; ЧВН=; ЧГ=0") + "_zv.xml";       // YYYYMMDD_NUMBER_zv
	ПолучениеЗавершено = Новый ОписаниеОповещения("ПолучениеРеализацииЗавершено",ЭтаФорма);
	НачатьПолучениеФайлаССервера(ПолучениеЗавершено,АдресВоВременномХранилище, ИмяФайла );
КонецПроцедуры

