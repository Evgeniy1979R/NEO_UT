&НаСервере
//Устарело
Процедура ДобавитьНоменклатуру(Поток, Выборка)
	Поток.ДобавитьСтроку("<Line>");//Поток.ЗаписатьНачалоЭлемента("Line"); 
	ЗаписатьОдноЗначение(Поток,"CODE",			СокрЛП(Выборка.Код)); 
	ЗаписатьОдноЗначение(Поток,"NAME",			СокрЛП(Выборка.НаименованиеПолное)); 
	ЗаписатьОдноЗначение(Поток,"UNIT",			СокрЛП(Выборка.ЕдиницаИзмеренияНаименование)); 
	ЗаписатьОдноЗначение(Поток,"UNITWEIGTH",	Формат(Выборка.ВесЧислитель,"ЧДЦ=3; ЧРД=.; ЧГ=0")); 
	ЗаписатьОдноЗначение(Поток,"GUID",			ПредставлениеGUID(Выборка.Ссылка)); 
	ЗаписатьОдноЗначение(Поток,"EAN",			СокрЛП(Выборка.ШтрихкодБазовой)); 
	ЗаписатьОдноЗначение(Поток,"EAN_P",			СокрЛП(Выборка.ШтрихкодУпаковки)); 
	ЗаписатьОдноЗначение(Поток,"NDS",			СтрЗаменить(Выборка.СтавкаНДС,"%",""));         
	ЗаписатьОдноЗначение(Поток,"PCS",			?(Выборка.ЕдиницаИзмеренияНаименование="шт","",Формат(Выборка.Коэффициент,"ЧДЦ=3; ЧРД=.; ЧГ=0"))); 
	ЗаписатьОдноЗначение(Поток,"SPEC",			Формат(Выборка.Коэффициент,"ЧДЦ=3; ЧРД=.; ЧГ=0"));
	Если НЕ ЗначениеЗаполнено(Выборка.СертификатыСсылка) тогда
		СообщитьПользователюОбОшибке("Не нашли сертификат для " + СокрЛП(Выборка.НаименованиеПолное));
	КонецЕсли;
	
	ЗаписатьОдноЗначение(Поток,"SERTNUM",		СокрЛП(Выборка.СертификатыНомер));
	ЗаписатьОдноЗначение(Поток,"SERTSEND",		СокрЛП(Выборка.СертификатыОрганВыдавшийДокумент));
	ЗаписатьОдноЗначение(Поток,"SERTBEGIN",		Формат(Выборка.СертификатыДатаНачалаСрокаДействия,"ДФ=dd.MM.yyyy"));     
	ЗаписатьОдноЗначение(Поток,"SERTEND",		Формат(Выборка.СертификатыДатаОкончанияСрокаДействия,"ДФ=dd.MM.yyyy"));     	
	
	подписант = Выборка.СертификатыОрганизацияПринявшаяСертификат;
	поз = СтрНайти(подписант,"директора");
	Если Поз =0 тогда
		СообщитьПользователюОбОшибке("Не нашли подписанта сертификата для " + СокрЛП(Выборка.НаименованиеПолное));
	КонецЕсли;
	
	подписант = Сред(подписант,поз);      
	поз = СтрНайти(подписант," ");
	подписант = Сред(подписант,поз);
	
	ЗаписатьОдноЗначение(Поток,"S_ACCEPT",		СокрЛП(подписант));     
	ЗаписатьОдноЗначение(Поток,"S_MFR",			СокрЛП(Выборка.Производитель));
	Если ЗначениеЗаполнено(Выборка.АртикулАшан) тогда
		ЗаписатьОдноЗначение(Поток,"AUCHAN",	СокрЛП(Выборка.АртикулАшан));
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.АртикулРеалОкей) тогда
		ЗаписатьОдноЗначение(Поток,"REAL",		СокрЛП(Выборка.АртикулРеалОкей));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.АртикулГиперглобус) тогда
		ЗаписатьОдноЗначение(Поток,"GLOBUS",	СокрЛП(Выборка.АртикулГиперглобус));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.АртикулХ5) тогда
		ЗаписатьОдноЗначение(Поток,"X5",		СокрЛП(Выборка.АртикулХ5));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.АртикулЛента) тогда
		ЗаписатьОдноЗначение(Поток,"LENTA",		СокрЛП(Выборка.АртикулЛента));
	КонецЕсли;
	
	ЗаписатьОдноЗначение(Поток,"GUID_M",		нрег(СокрЛП(Выборка.GUIDМеркурий)));
	ЗаписатьОдноЗначение(Поток,"S_GUID",		ПредставлениеGUID(Выборка.СертификатыСсылка));
	ЗаписатьОдноЗначение(Поток,"VETERINAR",		?(ЗначениеЗаполнено(СокрЛП(Выборка.GUIDМеркурий)),"1","0"));
	ЗаписатьОдноЗначение(Поток,"S_TNVD",		СокрЛП(Выборка.КодТНВЭД));
	ЗаписатьОдноЗначение(Поток,"DaysStorage",	Формат(Выборка.СрокГодности,"ЧДЦ=0; ЧГ=0"));  
	ЗаписатьОдноЗначение(Поток,"PC_use",		"");	//Это поле не заполняем
	ЗаписатьОдноЗначение(Поток,"BoxesOnPallet",	Формат(Выборка.КоличествоУпаковокНаПаллете,"ЧДЦ=0; ЧГ=0"));
	ЗаписатьОдноЗначение(Поток,"PalletWeight",	Формат(Выборка.КоличествоУпаковокНаПаллете* Выборка.Коэффициент * Выборка.ВесБрутто,"ЧДЦ=3; ЧРД=.; ЧГ=0"));
	ЗаписатьОдноЗначение(Поток,"COOLED",		"0");
	
	
	Поток.ДобавитьСтроку("</Line>") //Поток.ЗаписатьКонецЭлемента();
КонецПроцедуры                                             

