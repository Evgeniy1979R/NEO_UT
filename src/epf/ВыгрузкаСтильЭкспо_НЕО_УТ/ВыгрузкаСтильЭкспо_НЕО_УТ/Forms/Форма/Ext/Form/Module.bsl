	Запрос.УстановитьПараметр("СписокРеализаций", СписокРеализаций.ВыгрузитьЗначения());
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДокументы = РезультатЗапроса[0].Выбрать();
	ВыборкаТовары = РезультатЗапроса[2].Выбрать();
	
	Результат = Новый Массив();
	Пока ВыборкаДокументы.Следующий() Цикл
		Элемент = новый Структура();
		Для каждого Колонка  из РезультатЗапроса[0].Колонки цикл
			Элемент.Вставить(Колонка.имя,ВыборкаДокументы[Колонка.имя]);
		КонецЦикла;                                                     
		Товары = Новый Массив();
		СтруктураПоиска = Новый Структура("Ссылка");
		СтруктураПоиска.Ссылка = ВыборкаДокументы.Ссылка;
		Пока ВыборкаТовары.НайтиСледующий(СтруктураПоиска) Цикл
			ЭлементТовара = новый Структура();
			Для каждого Колонка  из РезультатЗапроса[2].Колонки цикл
				ЭлементТовара.Вставить(Колонка.имя,ВыборкаТовары[Колонка.имя]);
			КонецЦикла;                                                     
			Товары.Добавить(ЭлементТовара);
		КонецЦикла;        
		Элемент.Вставить("Товары",Товары);
		Результат.Добавить(Элемент);		
		ВыборкаТовары.Сбросить();
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
функция ВыгрузитьРеализацииНаСервере()
	ДанныеДляВыгрузки = ПодготовитьДанныеДляВыгрузкиРеализаций();
	
	СтильЭкспоXSD = РеквизитФормыВЗначение("Объект").ПолучитьМакет("СтильЭкспоXSD");
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	СтильЭкспоXSD.Записать(ИмяВременногоФайла);
	МассивФайловСхем = Новый Массив;
	МассивФайловСхем.Добавить(ИмяВременногоФайла);
	Фабрика = СоздатьФабрикуXDTO(МассивФайловСхем);
	ТипФайл = Фабрика.Тип("https://StyleExpo","Файл");
	ТипДокумент = Фабрика.Тип("https://StyleExpo","ДокументТип");
	ГрузополучательТип = Фабрика.Тип("https://StyleExpo","ГрузополучательТип");
	ОснованиеТип = Фабрика.Тип("https://StyleExpo","ОснованиеТип");
	ТоварыТип	= Фабрика.Тип("https://StyleExpo","ТоварыТип");
	СтрокаТовараТип = Фабрика.Тип("https://StyleExpo","СтрокаТовараТип");
	УпаковкаТип = Фабрика.Тип("https://StyleExpo","УпаковкаТип");
	КарточкаТовараТип = Фабрика.Тип("https://StyleExpo","КарточкаТовараТип");
	УпаковкаТип			= Фабрика.Тип("https://StyleExpo","УпаковкаТип");
	АдресТип		= Фабрика.Тип("https://StyleExpo","АдресТип");
	Файл = Фабрика.Создать(ТипФайл);
	Файл.ВерсияФормата = "1.0";
	Для Каждого Шапка из ДанныеДляВыгрузки Цикл
		Документ = Фабрика.Создать(ТипДокумент);
		Файл.Документ.Добавить(Документ);
		Документ.ТипДокумента = ТипДокумента_Отгрузка();
		Документ.ДатаДокумента = Шапка.Дата;
		оЗаказчик = Фабрика.Создать(ГрузополучательТип);
		ЗаполнитьОГрузополучатель(оЗаказчик,Шапка.Организация);
		Документ.Заказчик = оЗаказчик;
		оГрузополучатель = Фабрика.Создать(ГрузополучательТип);
		ЗаполнитьОГрузополучатель(оГрузополучатель,?(ЗначениеЗаполнено(Шапка.Грузополучатель) = Истина ,Шапка.Грузополучатель, Шапка.Контрагент),Истина,Фабрика.Создать(АдресТип),Шапка.АдресДоставкиЗначенияПолей);
		Документ.Грузополучатель = оГрузополучатель;
		оОснование = Фабрика.Создать(ОснованиеТип);
		оОснование.Наименование = ""+Шапка.Ссылка;
		оОснование.Номер = Шапка.Номер;
		оОснование.Дата = Шапка.Дата;
		Документ.Основание = оОснование;
		Документ.ТемпературныйРежим = ТемпературныйРежим_ЗамороженнаяПродукция();
		Документ.Комментарий = "";
		оТовары = Фабрика.Создать(ТоварыТип);
		Документ.Товары = оТовары;
		
		Для Каждого СтрокаТовары из Шапка.Товары Цикл
			оСтрока = Фабрика.Создать(СтрокаТовараТип);
			оТовары.Строка.Добавить(оСтрока);
			оТовар  = Фабрика.Создать(КарточкаТовараТип);
			оСтрока.Товар = оТовар;
			оУпаковка = Фабрика.Создать(УпаковкаТип);
			оСтрока.Упаковка = оУпаковка;			
			оТовар.Артикул = СтрокаТовары.НоменклатураКод;
			оТовар.Идентификатор = XMLСтрока(СтрокаТовары.Номенклатура.УникальныйИдентификатор());
			оТовар.Наименование	 = СтрокаТовары.НоменклатураНаименование;
			оТовар.КодЕдиницыИзмерения = СтрокаТовары.НоменклатураЕдиницаИзмеренияКод;
			оТовар.СрокГодности		= СрокГодностиВДнях(СтрокаТовары.НоменклатураСрокГодности,СтрокаТовары.НоменклатураЕдиницаИзмеренияСрокаГодности);;
			оУпаковка.КоличествоВУпаковке =  СтрокаТовары.УпаковкаКоэффициент;
			оУпаковка.КодЕдиницыИзмерения =  СтрокаТовары.УпаковкаЕдиницаКод;
			ЗначениеДатыВыпуска = '00010101';
			сДатыВыпуска = Неопределено;
			ЗначениеДатыВыпуска = '20260101';
			Если сДатыВыпуска <> Неопределено Тогда 
				сДатаВыпускаСтрока = сДатыВыпуска.Строки.Найти(СтрокаТовары.НомерСтроки,"НомерСтроки",Ложь);
				Если сДатаВыпускаСтрока <> Неопределено Тогда
					ЗначениеДатыВыпуска = сДатаВыпускаСтрока.ДатаВыпуска;
				КонецЕсли;
			КонецЕсли;			
			оСтрока.ДатаПроизводства = ЗначениеДатыВыпуска;
			оСтрока.ГоденДо = ЗначениеДатыВыпуска + 86400*оТовар.СрокГодности;
			оСтрока.Количество = СтрокаТовары.Количество;
			оСтрока.КоличествоУпаковок = СтрокаТовары.КоличествоУпаковок;
			оСтрока.Цена = Окр(СтрокаТовары.СуммаСНДС/СтрокаТовары.КоличествоУпаковок,2);
			острока.СтавкаНДС = ПреобразоватьСтавкуНДС(СтрокаТовары.СтавкаНДС);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗаписьXML = Новый ЗаписьXML;
	ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML("windows-1251","1.0",Истина,Истина,Символы.Таб);
	ЗаписьXML.УстановитьСтроку(ПараметрыЗаписиXML);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	Фабрика.ЗаписатьXML(ЗаписьXML, Файл);
	XmlСтрокой = ЗаписьXML.Закрыть();
	XmlСтрокой = СтрЗаменить(XmlСтрокой ,Символы.ПС,Символы.ВК+Символы.ПС);
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(XmlСтрокой,"windows-1251");		
	Возврат поместитьВоВременноеХранилище(ДвоичныеДанные);
	
КонецФункции

&НаСервере
Процедура СообщитьПользователюОбОшибке(Сообщение)
	
	Сооб = Новый СообщениеПользователю() ;
	Сооб.Текст = Сообщение;
	Сооб.Сообщить();  
	Если ОстанавливатьсяПриОшибке тогда 
		ВызватьИсключение(Сообщение);
	КонецЕсли;
	
КонецПроцедуры

