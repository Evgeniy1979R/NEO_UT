	|	Контрагенты.ГоловнойКонтрагент.КодПоОКПО КАК ГоловнойКодПоОКПО,
	|	ЕСТЬNULL(КонтрагентыКонтактнаяИнформацияФактический.Представление, """") КАК ФактическийАдрес,
	|	ЕСТЬNULL(КонтрагентыКонтактнаяИнформацияЮридический.Представление, """") КАК ГоловнойЮридическийАдрес,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.Наименование, """") КАК ГоловнойДоговорНаименование,
	|	ЕСТЬNULL(КонтрагентыДопРеквизиты_Гуид_Меркурий.Значение, """") КАК ЭлементМеркурий,
	|	ЕСТЬNULL(БанковскиеСчетаКонтрагентов.НомерСчета, """") КАК ГоловнойНомерСчета,
	|	ЕСТЬNULL(КлассификаторБанков.Код, """") КАК ГоловнойБик,
	|	Контрагенты.ГоловнойКонтрагент.Ссылка КАК ГоловнойСсылка,
	|	ЕСТЬNULL(ВЗ_КодНеоВСистемеПокупателя.Значение, """") КАК КодНеоВСистемеПокупателя
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформацияЮридический
	|		ПО Контрагенты.ГоловнойКонтрагент = КонтрагентыКонтактнаяИнформацияЮридический.Ссылка
	|			И (КонтрагентыКонтактнаяИнформацияЮридический.Вид = &ВидЮр)
	|			И (КонтрагентыКонтактнаяИнформацияЮридический.Тип = &ТипЮр)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформацияФактический
	|		ПО Контрагенты.Ссылка = КонтрагентыКонтактнаяИнформацияФактический.Ссылка
	|			И (КонтрагентыКонтактнаяИнформацияФактический.Вид = &ВидФакт)
	|			И (КонтрагентыКонтактнаяИнформацияФактический.Тип = &ТипФакт)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.ДополнительныеРеквизиты КАК КонтрагентыДопРеквизиты_Гуид_Меркурий
	|		ПО (КонтрагентыДопРеквизиты_Гуид_Меркурий.Ссылка = Контрагенты.Ссылка)
	|			И (КонтрагентыДопРеквизиты_Гуид_Меркурий.Свойство.Имя = ""GUIDЭлементаВСистемеМеркурий_c505da1e0aec4fd2bc18990e9e480164"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ДоговорыКонтрагентов.Контрагент КАК Контрагент,
	|			МИНИМУМ(ДоговорыКонтрагентов.Ссылка) КАК Договор
	|		ИЗ
	|			Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ГДЕ
	|			ДоговорыКонтрагентов.Контрагент В(&СписокКонтрагентов)
	|			И ДоговорыКонтрагентов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Действует)
	|			И НЕ ДоговорыКонтрагентов.ПометкаУдаления
	|			И ДоговорыКонтрагентов.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ДоговорыКонтрагентов.Контрагент) КАК ПервыйДоговор
	|		ПО Контрагенты.ГоловнойКонтрагент = ПервыйДоговор.Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО (ПервыйДоговор.Договор = ДоговорыКонтрагентов.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			БанковскиеСчетаКонтрагентов.Владелец КАК Контрагент,
	|			МИНИМУМ(БанковскиеСчетаКонтрагентов.Ссылка) КАК БанковскийСчет
	|		ИЗ
	|			Справочник.БанковскиеСчетаКонтрагентов КАК БанковскиеСчетаКонтрагентов
	|		ГДЕ
	|			БанковскиеСчетаКонтрагентов.Владелец В(&СписокКонтрагентов)
	|			И НЕ БанковскиеСчетаКонтрагентов.ПометкаУдаления
	|		
	|		СГРУППИРОВАТЬ ПО
	|			БанковскиеСчетаКонтрагентов.Владелец) КАК ПервыйБанковскийСчет
	|		ПО Контрагенты.ГоловнойКонтрагент = ПервыйБанковскийСчет.Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчетаКонтрагентов КАК БанковскиеСчетаКонтрагентов
	|		ПО (ПервыйБанковскийСчет.БанковскийСчет = БанковскиеСчетаКонтрагентов.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторБанков КАК КлассификаторБанков
	|		ПО (БанковскиеСчетаКонтрагентов.Банк = КлассификаторБанков.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ДополнительныеСведения.Объект КАК Объект,
	|			ДополнительныеСведения.Свойство КАК Свойство,
	|			ДополнительныеСведения.Значение КАК Значение
	|		ИЗ
	|			РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|		ГДЕ
	|			ДополнительныеСведения.Свойство.Имя = ""Др_КодНеопродуктВУчетнойСистемеПокупателя""
	|			И ДополнительныеСведения.Объект В
	|					(ВЫБРАТЬ
	|						Контрагенты.Партнер КАК Партнер
	|					ИЗ
	|						Справочник.Контрагенты КАК Контрагенты
	|					ГДЕ
	|						Контрагенты.Ссылка В (&СписокКонтрагентов))) КАК ВЗ_КодНеоВСистемеПокупателя
	|		ПО Контрагенты.ГоловнойКонтрагент.Партнер = ВЗ_КодНеоВСистемеПокупателя.Объект
	|ГДЕ
	|	Контрагенты.Ссылка В(&СписокКонтрагентов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ГоловнойИНН,
	|	ГоловнойКПП,
	|	КПП";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Поток = новый ТекстовыйДокумент(); 
	Поток.ДобавитьСтроку("<ADDRESS>");
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДобавитьОдинАдрес(Поток,ВыборкаДетальныеЗаписи);
		
	КонецЦикла;
	
	Поток.ДобавитьСтроку("</ADDRESS>");
	файл = ПолучитьИмяВременногоФайла("xml");
	Поток.Записать(файл);
	Возврат поместитьВоВременноеХранилище(Новый Двоичныеданные(файл));
	
КонецФункции

&НаСервере
//Устарело
Процедура ДобавитьОдинАдрес(Поток, ВыборкаДетальныеЗаписи)
	
	Поток.ДобавитьСтроку("<Line>");
	ЗаписатьОдноЗначение(Поток,"KCODE",			"1"); //Головной 	ПредставлениеGUID(ВыборкаДетальныеЗаписи.ГоловнойСсылка),ВыборкаДетальныеЗаписи.ГоловнойСсылка
	ЗаписатьОдноЗначение(Поток,"KNAME",			СокрЛП(ВыборкаДетальныеЗаписи.ФактическийАдрес));      //09.04.25 Это адрес куда будет доставка, должен быть полный адрес с индексом 
	ЗаписатьОдноЗначение(Поток,"KFULLNAME",		СокрЛП(ВыборкаДетальныеЗаписи.ГоловнойНаименованиеПолное));//Головной 
	ЗаписатьОдноЗначение(Поток,"KINN",			СокрЛП(ВыборкаДетальныеЗаписи.ГоловнойИНН));               //Головной
	ЗаписатьОдноЗначение(Поток,"KKPP",			СокрЛП(ВыборкаДетальныеЗаписи.ГоловнойКПП));               //Головной
	ЗаписатьОдноЗначение(Поток,"BuyerCode",		ВыборкаДетальныеЗаписи.КодНеоВСистемеПокупателя);		   //Головной
	ЗаписатьОдноЗначение(Поток,"KGUID",			ПредставлениеGUID(ВыборкаДетальныеЗаписи.ГоловнойСсылка),ВыборкаДетальныеЗаписи.ГоловнойСсылка); //Головной
	ЗаписатьОдноЗначение(Поток,"KCONTRACT",		СокрЛП(ВыборкаДетальныеЗаписи.ГоловнойДоговорНаименование));//Головной
	ЗаписатьОдноЗначение(Поток,"OKPO",			СокрЛП(ВыборкаДетальныеЗаписи.ГоловнойКодПоОКПО));	       //Головной
	ЗаписатьОдноЗначение(Поток,"CODE",			"1",ВыборкаДетальныеЗаписи.Ссылка); //Обособка ПредставлениеGUID(ВыборкаДетальныеЗаписи.Ссылка)
	ЗаписатьОдноЗначение(Поток,"NAME",			СокрЛП(ВыборкаДетальныеЗаписи.ФактическийАдрес));  //Обособка
	ЗаписатьОдноЗначение(Поток,"GUID",			ПредставлениеGUID(ВыборкаДетальныеЗаписи.Ссылка),ВыборкаДетальныеЗаписи.Ссылка); //Обособка
	ЗаписатьОдноЗначение(Поток,"KADDRESS",		СокрЛП(ВыборкаДетальныеЗаписи.ГоловнойЮридическийАдрес));  //Головной
	ЗаписатьОдноЗначение(Поток,"ACCOUNT",		СокрЛП(ВыборкаДетальныеЗаписи.ГоловнойНомерСчета));        //Головной
	ЗаписатьОдноЗначение(Поток,"BIK",			СокрЛП(ВыборкаДетальныеЗаписи.ГоловнойБИК));               //Головной
	ЗаписатьОдноЗначение(Поток,"KPP",			СокрЛП(ВыборкаДетальныеЗаписи.КПП));               //Обособка
	ЗаписатьОдноЗначение(Поток,"NUMSHOP",		"");                                               //--
	ЗаписатьОдноЗначение(Поток,"GLN",			"");                                               //--
	ЗаписатьОдноЗначение(Поток,"GUID_M",		СокрЛП(ВыборкаДетальныеЗаписи.ЭлементМеркурий));   //Обособка
	Поток.ДобавитьСтроку("</Line>");
	
КонецПроцедуры

