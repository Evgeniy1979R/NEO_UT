	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО (РеализацияТоваровУслугТовары.Номенклатура = УпаковкиЕдиницыИзмерения.Владелец)
	|			И (РеализацияТоваровУслугТовары.Ссылка В (&СписокРеализаций))
	|ГДЕ
	|	УпаковкиЕдиницыИзмерения.Родитель = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	УпаковкиЕдиницыИзмерения.Ссылка,
	|	УпаковкиЕдиницыИзмерения.Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугВидыЗапасов.Ссылка КАК Ссылка,
	|	РеализацияТоваровУслугВидыЗапасов.НомерСтроки КАК НомерСтроки,
	|	КлючиАналитикиУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	СпрНоменклатура.Код КАК НоменклатураКод,
	|	СпрНоменклатура.НаименованиеПолное КАК НоменклатураНаименованиеПолное,
	|	РеализацияТоваровУслугВидыЗапасов.СтавкаНДС КАК СтавкаНДС,
	|	РеализацияТоваровУслугВидыЗапасов.КоличествоУпаковок КАК КоличествоУпаковок,
	|	РеализацияТоваровУслугВидыЗапасов.Количество КАК Количество,
	|	РеализацияТоваровУслугВидыЗапасов.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслугВидыЗапасов.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА СпрНоменклатура.ЕдиницаИзмерения
	|		ИНАЧЕ РеализацияТоваровУслугВидыЗапасов.Упаковка
	|	КОНЕЦ КАК ПроверкаУпаковки,
	|	СпрНоменклатура.ЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
	|	РеализацияТоваровУслугВидыЗапасов.Цена КАК Цена,
	|	РеализацияТоваровУслугВидыЗапасов.СуммаНДС КАК СуммаНДС,
	|	РеализацияТоваровУслугВидыЗапасов.СуммаСНДС КАК СуммаСНДС,
	|	НомераГТД.РегистрационныйНомер КАК РегистрационныйНомер,
	|	НомераГТД.СтранаПроисхождения КАК СтранаПроисхождения,
	|	СтраныМира.Код КАК СтранаКод,
	|	ЕСТЬNULL(Упаковки.Наименование, """") КАК УпаковкиНаименование,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Наименование, """") КАК НоменклатураЕдиницыИзмеренияНаименование,
	|	СпрНоменклатура.ВесЧислитель / ВЫБОР
	|		КОГДА СпрНоменклатура.ВесЗнаменатель = 0
	|			ТОГДА 1
	|		ИНАЧЕ СпрНоменклатура.ВесЗнаменатель
	|	КОНЕЦ КАК ВесЧислитель,
	|	СпрНоменклатура.ВесБрутто КАК ВесБрутто,
	|	ЕСТЬNULL(вт_Упаковки.Числитель, 1) КАК МинимальнаяКоробка,
	|	РеализацияТоваровУслугВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	ЕСТЬNULL(РеализацияТоваровУслугВидыЗапасов.Упаковка.Код, РеализацияТоваровУслугВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения.Код) КАК УпаковкаЕдиницаКод,
	|	РеализацияТоваровУслугВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения.Код КАК НоменклатураЕдиницаИзмеренияКод,
	|	РеализацияТоваровУслугВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура.СрокГодности КАК НоменклатураСрокГодности,
	|	РеализацияТоваровУслугВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмеренияСрокаГодности КАК НоменклатураЕдиницаИзмеренияСрокаГодности,
	|	ЕСТЬNULL(РеализацияТоваровУслугВидыЗапасов.Упаковка.Числитель, 1) / ВЫБОР
	|		КОГДА ЕСТЬNULL(РеализацияТоваровУслугВидыЗапасов.Упаковка.Знаменатель, 1) = 0
	|			ТОГДА 1
	|		ИНАЧЕ ЕСТЬNULL(РеализацияТоваровУслугВидыЗапасов.Упаковка.Знаменатель, 1)
	|	КОНЕЦ КАК УпаковкаКоэффициент
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ВидыЗапасов КАК РеализацияТоваровУслугВидыЗапасов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК КлючиАналитикиУчетаНоменклатуры
	|		ПО РеализацияТоваровУслугВидыЗапасов.АналитикаУчетаНоменклатуры = КлючиАналитикиУчетаНоменклатуры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО (КлючиАналитикиУчетаНоменклатуры.Номенклатура = СпрНоменклатура.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК НомераГТД
	|		ПО РеализацияТоваровУслугВидыЗапасов.НомерГТД = НомераГТД.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|		ПО (НомераГТД.СтранаПроисхождения = СтраныМира.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК Упаковки
	|		ПО РеализацияТоваровУслугВидыЗапасов.Упаковка = Упаковки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|		ПО (СпрНоменклатура.ЕдиницаИзмерения = УпаковкиЕдиницыИзмерения.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ вт_Упаковки КАК вт_Упаковки
	|		ПО (вт_Упаковки.Номенклатура = СпрНоменклатура.Ссылка)
	|ГДЕ
	|	РеализацияТоваровУслугВидыЗапасов.Ссылка В(&СписокРеализаций)
	|
	|УПОРЯДОЧИТЬ ПО
	|	РеализацияТоваровУслугВидыЗапасов.Ссылка,
	|	РеализацияТоваровУслугВидыЗапасов.НомерСтроки";
	
	
	Запрос.УстановитьПараметр("СписокРеализаций", СписокРеализаций.ВыгрузитьЗначения());
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДокументы = РезультатЗапроса[0].Выбрать();
	ВыборкаТовары = РезультатЗапроса[2].Выбрать();
	
	Результат = Новый Массив();
	Пока ВыборкаДокументы.Следующий() Цикл
		Элемент = новый Структура();
		Для каждого Колонка  из РезультатЗапроса[0].Колонки цикл
			Элемент.Вставить(Колонка.имя,ВыборкаДокументы[Колонка.имя]);
		КонецЦикла;                                                     
		Товары = Новый Массив();
		СтруктураПоиска = Новый Структура("Ссылка");
		СтруктураПоиска.Ссылка = ВыборкаДокументы.Ссылка;
		Пока ВыборкаТовары.НайтиСледующий(СтруктураПоиска) Цикл
			ЭлементТовара = новый Структура();
			Для каждого Колонка  из РезультатЗапроса[2].Колонки цикл
				ЭлементТовара.Вставить(Колонка.имя,ВыборкаТовары[Колонка.имя]);
			КонецЦикла;                                                     
			Товары.Добавить(ЭлементТовара);
		КонецЦикла;        
		Элемент.Вставить("Товары",Товары);
		Результат.Добавить(Элемент);		
		ВыборкаТовары.Сбросить();
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
функция ВыгрузитьРеализацииНаСервере()
	ДанныеДляВыгрузки = ПодготовитьДанныеДляВыгрузкиРеализаций();
	
	СтильЭкспоXSD = РеквизитФормыВЗначение("Объект").ПолучитьМакет("СтильЭкспоXSD");
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	СтильЭкспоXSD.Записать(ИмяВременногоФайла);
	МассивФайловСхем = Новый Массив;
	МассивФайловСхем.Добавить(ИмяВременногоФайла);
	Фабрика = СоздатьФабрикуXDTO(МассивФайловСхем);
	ТипФайл = Фабрика.Тип("https://StyleExpo","Файл");
	ТипДокумент = Фабрика.Тип("https://StyleExpo","ДокументТип");
	ГрузополучательТип = Фабрика.Тип("https://StyleExpo","ГрузополучательТип");
	ОснованиеТип = Фабрика.Тип("https://StyleExpo","ОснованиеТип");
	ТоварыТип	= Фабрика.Тип("https://StyleExpo","ТоварыТип");
	СтрокаТовараТип = Фабрика.Тип("https://StyleExpo","СтрокаТовараТип");
	УпаковкаТип = Фабрика.Тип("https://StyleExpo","УпаковкаТип");
	КарточкаТовараТип = Фабрика.Тип("https://StyleExpo","КарточкаТовараТип");
	УпаковкаТип			= Фабрика.Тип("https://StyleExpo","УпаковкаТип");
	АдресТип		= Фабрика.Тип("https://StyleExpo","АдресТип");
	Файл = Фабрика.Создать(ТипФайл);
	Файл.ВерсияФормата = "1.0";
	Для Каждого Шапка из ДанныеДляВыгрузки Цикл
		Документ = Фабрика.Создать(ТипДокумент);
		Файл.Документ.Добавить(Документ);
		Документ.ТипДокумента = ТипДокумента_Отгрузка();
		Документ.ДатаДокумента = Шапка.Дата;
		оЗаказчик = Фабрика.Создать(ГрузополучательТип);
		ЗаполнитьОГрузополучатель(оЗаказчик,Шапка.Организация);
		Документ.Заказчик = оЗаказчик;
		оГрузополучатель = Фабрика.Создать(ГрузополучательТип);
		ЗаполнитьОГрузополучатель(оГрузополучатель,?(ЗначениеЗаполнено(Шапка.Грузополучатель) = Истина ,Шапка.Грузополучатель, Шапка.Контрагент),Истина,Фабрика.Создать(АдресТип),Шапка.АдресДоставкиЗначенияПолей);
		Документ.Грузополучатель = оГрузополучатель;
		оОснование = Фабрика.Создать(ОснованиеТип);
		оОснование.Наименование = ""+Шапка.Ссылка;
		оОснование.Номер = Шапка.Номер;
		оОснование.Дата = Шапка.Дата;
		Документ.Основание = оОснование;
		Документ.ТемпературныйРежим = ТемпературныйРежим_ЗамороженнаяПродукция();
		Документ.Комментарий = "";
		оТовары = Фабрика.Создать(ТоварыТип);
		Документ.Товары = оТовары;
		
		Для Каждого СтрокаТовары из Шапка.Товары Цикл
			оСтрока = Фабрика.Создать(СтрокаТовараТип);
			оТовары.Строка.Добавить(оСтрока);
			оТовар  = Фабрика.Создать(КарточкаТовараТип);
			оСтрока.Товар = оТовар;
			оУпаковка = Фабрика.Создать(УпаковкаТип);
			оСтрока.Упаковка = оУпаковка;			
			оТовар.Артикул = СтрокаТовары.НоменклатураКод;
			оТовар.Идентификатор = XMLСтрока(СтрокаТовары.Номенклатура.УникальныйИдентификатор());
			оТовар.Наименование	 = СтрокаТовары.НоменклатураНаименование;
			оТовар.КодЕдиницыИзмерения = СтрокаТовары.НоменклатураЕдиницаИзмеренияКод;
			оТовар.СрокГодности		= СрокГодностиВДнях(СтрокаТовары.НоменклатураСрокГодности,СтрокаТовары.НоменклатураЕдиницаИзмеренияСрокаГодности);;
			оУпаковка.КоличествоВУпаковке =  СтрокаТовары.УпаковкаКоэффициент;
			оУпаковка.КодЕдиницыИзмерения =  СтрокаТовары.УпаковкаЕдиницаКод;
			ЗначениеДатыВыпуска = '00010101';
			сДатыВыпуска = Неопределено;
			ЗначениеДатыВыпуска = '20260101';
			Если сДатыВыпуска <> Неопределено Тогда 
				сДатаВыпускаСтрока = сДатыВыпуска.Строки.Найти(СтрокаТовары.НомерСтроки,"НомерСтроки",Ложь);
				Если сДатаВыпускаСтрока <> Неопределено Тогда
					ЗначениеДатыВыпуска = сДатаВыпускаСтрока.ДатаВыпуска;
				КонецЕсли;
			КонецЕсли;			
			оСтрока.ДатаПроизводства = ЗначениеДатыВыпуска;
			оСтрока.ГоденДо = ЗначениеДатыВыпуска + 86400*оТовар.СрокГодности;
			оСтрока.Количество = СтрокаТовары.Количество;
			оСтрока.КоличествоУпаковок = СтрокаТовары.КоличествоУпаковок;
			оСтрока.Цена = Окр(СтрокаТовары.СуммаСНДС/СтрокаТовары.КоличествоУпаковок,2);
			острока.СтавкаНДС = ПреобразоватьСтавкуНДС(СтрокаТовары.СтавкаНДС);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗаписьXML = Новый ЗаписьXML;
	ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML("windows-1251","1.0",Истина,Истина,Символы.Таб);
	ЗаписьXML.УстановитьСтроку(ПараметрыЗаписиXML);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	Фабрика.ЗаписатьXML(ЗаписьXML, Файл);
	XmlСтрокой = ЗаписьXML.Закрыть();
	XmlСтрокой = СтрЗаменить(XmlСтрокой ,Символы.ПС,Символы.ВК+Символы.ПС);
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(XmlСтрокой,"windows-1251");		
	Возврат поместитьВоВременноеХранилище(ДвоичныеДанные);
	
КонецФункции

&НаСервере
Процедура СообщитьПользователюОбОшибке(Сообщение)
	
	Сооб = Новый СообщениеПользователю() ;
	Сооб.Текст = Сообщение;
	Сооб.Сообщить();  
	Если ОстанавливатьсяПриОшибке тогда 
		ВызватьИсключение(Сообщение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
функция ПодготовитьНомер(ВхНомер)
	
	Возврат ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(ПрефиксацияОбъектовКлиентСервер.УдалитьПрефиксыИзНомераОбъекта(ВхНомер,Истина,Истина));
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьПоступленияПослеВводаДат(Результат,ДополнительныеПараметры) Экспорт 
	
	Если ТипЗнч(Результат) = Тип("Структура") и Результат.Действие = "ОК" Тогда 
		
		АдресВоВременномХранилище = ВыгрузитьПоступленияНаСервере(Результат.Адрес); 
		
		ИмяФайла = СтрШаблон("%1\%2_%3_transfer.xml", 
		КаталогВыгрузки,
		Формат(ТекущаяДата(),"ДФ=yyyyMMdd"),
		Формат(НомерФайлаПоступлений,"ЧЦ=4; ЧДЦ=0; ЧВН=; ЧГ=0"));
		
		ПолучениеЗавершено = Новый ОписаниеОповещения("ПолучениеПоступленийЗавершено",ЭтаФорма);
		НачатьПолучениеФайлаССервера(ПолучениеЗавершено,АдресВоВременномХранилище, ИмяФайла );
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеПоступленийЗавершено(ПолученныйФайл, ДополнительныеПараметры) экспорт
	Сооб = Новый СообщениеПользователю() ;
	Сооб.Текст = "Файл " + ПолученныйФайл.ПолноеИмя + " записан";
	Сооб.Сообщить();
КонецПроцедуры

&НаСервере
Функция ВыгрузитьПоступленияНаСервере(Адрес)     
	ДеревоДатВыпуска = ПолучитьИзВременногоХранилища(Адрес);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПриобретениеТоваровУслуг.Ссылка КАК Ссылка,
	|	ПриобретениеТоваровУслуг.Организация КАК Организация,
	|	ПРЕДСТАВЛЕНИЕ(ПриобретениеТоваровУслуг.Ссылка) КАК РеализацияПредставление,
	|	ПриобретениеТоваровУслуг.Номер КАК Номер,
	|	ПриобретениеТоваровУслуг.Дата КАК Дата,
	|	ПриобретениеТоваровУслуг.Контрагент КАК Контрагент,
	|	ПриобретениеТоваровУслуг.Комментарий КАК Комментарий
	|ИЗ
