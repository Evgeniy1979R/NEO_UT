//Устарело
Процедура ЗаписатьОдноЗначение(Поток,Имя,Значение, Знач Комментарий = "")
	Если ВыводитьКомментарии = Ложь Тогда 
		Комментарий = "";
	Иначе
		Комментарий = ""+Комментарий;
	КонецЕсли;
	
	
	Поток.ДобавитьСтроку(
	СтрШаблон("<%1>%2</%1>%3",Имя,XMLСтрока(Значение),? (Комментарий = "","",СтрШаблон("<!--%1-->",XMLСтрока(Комментарий)))));
	
