&НаСервере
Процедура ЗаполнитьОГрузополучатель(оГрузополучатель,КонтрагентОрганизация,ЗаполнятьАдрес = Ложь, оАдрес = Неопределено,ЗначениеАдреса = "")
	оГрузополучатель.Наименование = КонтрагентОрганизация.Наименование;
	оГрузополучатель.ИНН		  = КонтрагентОрганизация.ИНН;
	оГрузополучатель.КПП			= КонтрагентОрганизация.КПП;
	оГрузополучатель.Идентификатор	= XMLСтрока(КонтрагентОрганизация.УникальныйИдентификатор());
	Если ЗаполнятьАдрес = Истина Тогда 
		МассивАдресов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗначениеАдреса);
		сАдрес = РаботаСАдресами.СведенияОбАдресах(МассивАдресов)[0];
		оАдрес.Индекс		= сАдрес.Индекс;
		оАдрес.КодРегиона	= сАдрес.КодРегиона; 
		оАдрес.Район	    = сАдрес.Район;
		// Москва является регионом, а город в этом случае остается пустым
		Если сАдрес.Город = "" Тогда 
			оАдрес.Город	    = сАдрес.Регион;
		Иначе
			
			оАдрес.Город	    = сАдрес.Город;
		КонецЕсли;
		оАдрес.НаселПункт	= сАдрес.НаселенныйПункт;		
		оАдрес.Улица	    = сАдрес.Улица;
		стмп =  Новый Структура("Номер,ТипЗдания","","");
		ЗаполнитьЗначенияСвойств(стмп,сАдрес.Здание);
		оАдрес.Дом	        = стмп.Номер;
		стмп = Новый Структура("Номер","" );
		
		Если ТипЗнч(сАдрес.Корпуса) = Тип("Массив") Тогда
			ЗаполнитьЗначенияСвойств(стмп,сАдрес.Корпуса[0]);
		КонецЕсли;
		
		оАдрес.Корпус	    = стмп.Номер;
		оАдрес.Квартира	    = "";
