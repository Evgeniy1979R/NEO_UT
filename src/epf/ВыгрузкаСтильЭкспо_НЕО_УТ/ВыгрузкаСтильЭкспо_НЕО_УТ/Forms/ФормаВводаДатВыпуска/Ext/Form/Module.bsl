
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	МассивПоступлений = Новый Массив;
	Для Каждого эл из Параметры.СписокПоступлений Цикл
		
		Если эл.Пометка = Истина Тогда 
			МассивПоступлений.Добавить(эл.Значение);
		КонецЕсли;
		
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивПоступлений",МассивПоступлений);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПриобретениеТоваровУслугТовары.Ссылка КАК ДокументПоступления,
	               |	ПриобретениеТоваровУслугТовары.НомерСтроки КАК НомерСтроки,
	               |	ПриобретениеТоваровУслугТовары.Номенклатура КАК Номенклатура,
	               |	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаВыпуска
	               |ИЗ
	               |	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
	               |ГДЕ
	               |	ПриобретениеТоваровУслугТовары.Ссылка В(&МассивПоступлений)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПриобретениеТоваровУслугТовары.Ссылка,
	               |	НомерСтроки
	               |ИТОГИ ПО
	               |	ДокументПоступления";
	дРезультат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
    ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам),"ДеревоДатВыпуска");

КонецПроцедуры

&НаСервере
Функция ПоместитьДеревоВоВременноеХранилище();
	ДеревоДатВыпускаЗначение = РеквизитФормыВЗначение("ДеревоДатВыпуска",Тип("ДеревоЗначений"));
	Возврат ПоместитьВоВременноеХранилище(ДеревоДатВыпускаЗначение);
КонецФункции

&НаКлиенте
Процедура ПродолжитьВыгрузку(Команда)
	
	Закрыть(Новый Структура("Действие,Адрес","ОК",ПоместитьДеревоВоВременноеХранилище() ));
	
КонецПроцедуры
