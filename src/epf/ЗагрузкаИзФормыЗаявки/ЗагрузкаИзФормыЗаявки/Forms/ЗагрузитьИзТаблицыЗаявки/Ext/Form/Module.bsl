&НаСервереБезКонтекста
Функция   СформироватьЧисло(ЧислоТекст) 
	Результат = "";
	ЧислоТекст = СтрЗаменить(ЧислоТекст,",",".");
	Для Позиция=1 По СтрДлина(ЧислоТекст) Цикл
		Если Найти("-+0123456789.",Сред(ЧислоТекст,Позиция,1)) > 0 Тогда
			Результат = Результат+Сред(ЧислоТекст,Позиция,1);	 
		КонецЕсли; 
	КонецЦикла; 
	Возврат ?(СтрДлина(Результат)>0,Результат,"0");
КонецФункции //СформироватьЧисло 
&НаСервере
Функция   ПолучитьСтруктуруТаблицыВнешниеДанные() 
	ВнешниеДанные = Новый ТаблицаЗначений;
	ВнешниеДанные.Колонки.Добавить("НоменклатураКод",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки (20)));
	ВнешниеДанные.Колонки.Добавить("Цена",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10,2)));
	ВнешниеДанные.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10,3)));
	ВнешниеДанные.Колонки.Добавить("Сумма",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10,2)));
	ВнешниеДанные.Колонки.Добавить("НомерСтроки",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10,2)));
	ВнешниеДанные.Колонки.Добавить("КоличествоУпаковок",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10,3)));
	ВнешниеДанные.Колонки.Добавить("Коэффициент",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10,3)));
	Возврат ВнешниеДанные ;
	
КонецФункции //ПолучитьСтруктуруТаблицыВнешниеДанные 
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ШаблонЗагрузки");
	ТабличноеПоле.Вывести(Макет.ПолучитьОбласть("Шапка"));
	ОбъектыНазначения="";
	Параметры.Свойство("ОбъектыНазначения",ОбъектыНазначения);
	Если ТипЗнч(ОбъектыНазначения) = Тип("Массив") Тогда
		Для каждого ЭлементМассива Из ОбъектыНазначения Цикл
			СписокОбъектовНазначения.Добавить(ЭлементМассива);
		КонецЦикла; 
	КонецЕсли; 
	ИзменитьЗаголовокФормы();
КонецПроцедуры

&НаСервере
Процедура ИзменитьЗаголовокФормы()
	СведенияОВнешнейОбрботке = РеквизитФормыВЗначение("Объект").СведенияОВнешнейОбработке();
	Заголовок = СтрШаблон("v.%1 %2",СведенияОВнешнейОбрботке.Версия,Заголовок);
КонецПроцедуры
&НаКлиенте
Процедура Загрузить(Команда)
	СсылкаНаДокумент  = СписокОбъектовНазначения [0].Значение;
	Форма = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента",Новый Структура("Ключ",СсылкаНаДОкумент)  ) ;
	ЗагрузитьНаСервере(Форма.УникальныйИдентификатор);
	Форма = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента",Новый Структура("Ключ",СсылкаНаДОкумент)  ) ;
	Если Форма.Открыта() Тогда
		Форма.Прочитать();
	КонецЕсли; 
	Закрыть(Истина);
КонецПроцедуры
&НаСервере
Процедура ЗагрузитьНаСервере(ИдентификаторФормыНазначения = Неопределено)
	ИНН = "!!!!!!!!!!!!";
	АдресДоставки = СокрЛП(ТабличноеПоле.Область(6,2,6,2).Текст);
	Комментарий   = СокрЛП(ТабличноеПоле.Область(6,6,6,6).Текст);
	
	
	#Область new_161022_2028_ЗагрузкаВТаблицуЗначений
	ВсегоСтрок = ТабличноеПоле.ВысотаТаблицы;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.ИдентификаторНазначения = ИдентификаторФормыНазначения;
	Сообщение.Текст = ""+ВсегоСтрок;
	Сообщение.Сообщить(); 
	ВнешниеДанные = ПолучитьСтруктуруТаблицыВнешниеДанные();
	ПустыхСтрок = 0;
	Для НомерСтроки = 10  По ВсегоСтрок Цикл
		Если ПустыхСтрок = 5 Тогда
			Прервать;
		КонецЕсли; 
		Если СокрЛп(ТабличноеПоле.Область(НомерСтроки,1,НомерСтроки,1).Текст)="" Тогда
			ПустыхСтрок = ПустыхСтрок+1;
			Продолжить;
		КонецЕсли; 
		ПустыхСтрок = 0;
		НоваяСтрока = ВнешниеДанные.Добавить();
		НоваяСтрока.НоменклатураКод 	= СокрЛп(ТабличноеПоле.Область(НомерСтроки,1,НомерСтроки,1).Текст);
		НоваяСтрока.Цена 				= 0;//Число(СформироватьЧисло(ТабличноеПоле.Область(НомерСтроки,7,НомерСтроки,7).Текст));
		НоваяСтрока.Количество 			= Число(СформироватьЧисло(ТабличноеПоле.Область(НомерСтроки,7).Текст));
		НоваяСтрока.КоличествоУпаковок 	= Число(СформироватьЧисло(ТабличноеПоле.Область(НомерСтроки,8).Текст));		
		НоваяСтрока.Сумма 				= 0;// Число(СформироватьЧисло(ТабличноеПоле.Область(НомерСтроки,10,НомерСтроки,10).Текст));
		
		НоваяСтрока.Коэффициент 		= Число(СформироватьЧисло(ТабличноеПоле.Область(НомерСтроки,6).Текст));
		НоваяСтрока.НомерСтроки			= НомерСтроки;
	КонецЦикла;
	#КонецОбласти		
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВнешниеДанные.НоменклатураКод,
	|	ВнешниеДанные.Цена,
	|	ВнешниеДанные.Количество,
	|	ВнешниеДанные.Сумма,
	|	ВнешниеДанные.КоличествоУпаковок,
	|	ВнешниеДанные.Коэффициент,
	|	ВнешниеДанные.НомерСтроки
	|ПОМЕСТИТЬ ВнешниеДанные
	|ИЗ
	|	&ВнешниеДанные КАК ВнешниеДанные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(Номенклатура.Ссылка) КАК НоменклатураСсылка,
	|	ВложенныйЗапрос.НоменклатураКод
	|ПОМЕСТИТЬ СоответствиеНоменклатуры
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВнешниеДанные.НоменклатураКод КАК НоменклатураКод
	|	ИЗ
	|		ВнешниеДанные КАК ВнешниеДанные
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВнешниеДанные.НоменклатураКод) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ВложенныйЗапрос.НоменклатураКод = Номенклатура.Код
	|			И (НЕ Номенклатура.ЭтоГруппа)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.НоменклатураКод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВнешниеДанные.НоменклатураКод,
	|	ВнешниеДанные.Цена,
	|	ВнешниеДанные.Количество,
	|	ВнешниеДанные.Сумма,
	|	ВнешниеДанные.КоличествоУпаковок,
	|	ВнешниеДанные.Коэффициент,
	|	СоответствиеНоменклатуры.НоменклатураСсылка,
	|	ВнешниеДанные.НомерСтроки
	|ПОМЕСТИТЬ ЗаказБезУпаковок
	|ИЗ
	|	ВнешниеДанные КАК ВнешниеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ СоответствиеНоменклатуры КАК СоответствиеНоменклатуры
	|		ПО ВнешниеДанные.НоменклатураКод = СоответствиеНоменклатуры.НоменклатураКод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказБезУпаковок.НоменклатураКод,
	|	ЗаказБезУпаковок.Цена,
	|	ЗаказБезУпаковок.Количество,
	|	ЗаказБезУпаковок.Сумма,
	|	ЗаказБезУпаковок.КоличествоУпаковок,
	|	ЗаказБезУпаковок.Коэффициент,
	|	ЗаказБезУпаковок.НоменклатураСсылка,
	|	ВложенныйЗапрос.Упаковка,
	|	ВложенныйЗапрос.НоменклатураСсылка.ЕдиницаИзмерения,
	|	ЗаказБезУпаковок.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ЗаказБезУпаковок КАК ЗаказБезУпаковок
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЗаказБезУпаковок.НоменклатураСсылка КАК НоменклатураСсылка,
	|			ЗаказБезУпаковок.Коэффициент КАК Коэффициент,
	|			МАКСИМУМ(УпаковкиЕдиницыИзмерения.Ссылка) КАК Упаковка
	|		ИЗ
	|			ЗаказБезУпаковок КАК ЗаказБезУпаковок
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|				ПО (ЗаказБезУпаковок.НоменклатураСсылка = УпаковкиЕдиницыИзмерения.Владелец
	|						ИЛИ ЗаказБезУпаковок.НоменклатураСсылка.НаборУпаковок = УпаковкиЕдиницыИзмерения.Владелец)
	|					И ЗаказБезУпаковок.Коэффициент = УпаковкиЕдиницыИзмерения.Числитель
	|					И (НЕ УпаковкиЕдиницыИзмерения.ПометкаУдаления)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ЗаказБезУпаковок.НоменклатураСсылка,
	|			ЗаказБезУпаковок.Коэффициент) КАК ВложенныйЗапрос
	|		ПО ЗаказБезУпаковок.НоменклатураСсылка = ВложенныйЗапрос.НоменклатураСсылка
	|			И ЗаказБезУпаковок.Коэффициент = ВложенныйЗапрос.Коэффициент
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Контрагенты.Ссылка) КАК КонтрагентСсылка,
	|	&Инн
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН");
	Запрос.УстановитьПараметр("ВнешниеДанные",ВнешниеДанные);
	Запрос.УстановитьПараметр("ИНН",ИНН);
	МассивРезультатов = Запрос.ВыполнитьПакет();
	КоличествоРезультатов = МассивРезультатов.Количество();
	ЗаполняемыйОбъект = СписокОбъектовНазначения[0].Значение.ПолучитьОбъект();
	
	Если Ложь Тогда 
		ЗаполняемыйОбъект = ДОкументы.ЗаказКлиента.СоздатьДокумент();
	КонецЕсли;
	
	Если ЗаполняемыйОбъект.Грузоотправитель.Пустая() Тогда 
		ЗаполняемыйОбъект.Грузоотправитель = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор("1b63db45-6fd9-11f1-b113-00155d110624")) ; //НЕО ПРОДУКТ ОП НФ: e1cib/data/Справочник.Контрагенты?ref=
	КонецЕсли;
	
	Товары = ЗаполняемыйОбъект.Товары;
	Выборка = МассивРезультатов[КоличествоРезультатов-1].Выбрать(ОбходРезультатаЗапроса.Прямой);
	Выборка.Следующий();
	ЗаполняемыйОбъект.Валюта = ЗначениеНастроекПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	
	
	Если Не АдресДоставки = "" и СтрНайти(НРег(АдресДоставки),"самовывоз") = 0 Тогда
		Попытка 
			//	ЗаполняемыйОбъект.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента;
			
			ЗаполняемыйОбъект.АдресДоставки = АдресДоставки;
			
			ОбщегоНазначенияУТВызовСервера.ЗаполнитьЗначенияПолейКИПоПредставлению(АдресДоставки, ЗаполняемыйОбъект.АдресДоставкиЗначенияПолей);
		исключение
			Сообщить("Ошибка при установке адарес доставки. "+ОписаниеОшибки());
			ИО = ИнформацияОбОшибке();
			Сообщить(ИО.ИмяМодуля+Символы.ПС+ИО.ИсходнаяСтрока+Символы.ПС+ИО.Описание);
		КонецПопытки;
		
		
	КонецЕсли;
	ЗаполняемыйОбъект.Комментарий = Комментарий;
	Товары.Очистить();
	Выборка = МассивРезультатов[КоличествоРезультатов-2].Выбрать(ОбходРезультатаЗапроса.Прямой);
	Пока Выборка.Следующий() Цикл
		Если Выборка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли; 
		СтрокаТовары = Товары.Добавить();
		СтрокаТовары.Номенклатура = Выборка.НоменклатураСсылка;
		Если Не ЗначениеЗаполнено(Выборка.НоменклатураСсылка) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не найдена номенклатура по коду:"+ Выборка.НоменклатураКод;
			Сообщение.ИдентификаторНазначения = ИдентификаторФормыНазначения;
			Сообщение.Сообщить();
		Иначе
			Если Не ЗаполнятьВШтуках и ЗначениеЗаполнено(Выборка.Упаковка)  Тогда
				СтрокаТовары.Упаковка = Выборка.Упаковка;
				СтрокаТовары.КоличествоУпаковок = Выборка.КоличествоУпаковок;
			Иначе
				СтрокаТовары.КоличествоУпаковок = Выборка.Количество;
			КонецЕсли; 
			
			СтрокаТовары.СтавкаНДС = СтрокаТовары.Номенклатура.СтавкаНДС;
			
		КонецЕсли; 
		СтрокаТовары.Количество = Выборка.Количество;
		
		СтрокаТовары.КлючСвязи = СтрокаТовары.НомерСтроки;
		СтрокаТовары.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Требуется;
	КонецЦикла; 
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ЗаполняемыйОбъект);
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("НалогообложениеНДС, Дата, ПоДатеОтгрузки", ЗаполняемыйОбъект.НалогообложениеНДС, ЗаполняемыйОбъект.Дата, Истина));
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДСВозвратнойТары", ЗаполняемыйОбъект.ВернутьМногооборотнуюТару);
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Истина));
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
	СтруктураДействий.Вставить("ЗаполнитьСодержание", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияСодержанияУслугиВСтрокеТЧ(Объект, Ложь));
	
	ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(ЗаполняемыйОбъект.Товары, СтруктураДействий, Неопределено);
	Если ЗаполняемыйОбъект.Соглашение.Пустая() = Ложь Тогда 
		ЗаполняемыйОбъект.ЗаполнитьУсловияПродажПоСоглашению();
	КонецЕсли;
	
	ЗаполняемыйОбъект.Записать(РежимЗаписиДокумента.Запись);
	Если ЗаполняемыйОбъект.Проведен Тогда
		Попытка
			ЗаполняемыйОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Ошибка проведения доукмента, документ распроведен!";
			Сообщение.ИдентификаторНазначения = ИдентификаторФормыНазначения;
			Сообщение.Сообщить(); 
			ЗаполняемыйОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецПопытки; 	
	КонецЕсли; 
КонецПроцедуры
&НаКлиентеНаСервереБезКонтекста
Функция ЗависимыеРеквизиты()
	
	Возврат Новый Структура(
	"БезВозвратнойТары,ОтмененоБезВозвратнойТары,Отменено",
	"Сумма,СуммаНДС,СуммаСНДС,СуммаРучнойСкидки",
	"Сумма,СуммаНДС,СуммаСНДС,СуммаРучнойСкидки",
	"Сумма,СуммаНДС,СуммаСНДС,СуммаРучнойСкидки");
	
КонецФункции
