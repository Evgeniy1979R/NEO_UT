	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдерНаТовары.ОтгружаемыеТовары КАК РасходныйОрдерНаТоварыОтгружаемыеТовары
	|		ПО ВТ.Номенклатура = РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура
	|			И ВТ.ХарактеристикаНоменклатуры = РасходныйОрдерНаТоварыОтгружаемыеТовары.Характеристика
	|			И (ПодходящиеОрдера.РасходныйОрдер = РасходныйОрдерНаТоварыОтгружаемыеТовары.Ссылка)
	|			И ВТ.СтрокаОрдера = РасходныйОрдерНаТоварыОтгружаемыеТовары.НомерСтроки";
	тНомераПартий = ЗапросНомеровПартий.Выполнить().Выгрузить();
	Пока Выборка.Следующий() Цикл
		
		ИндексСтроки = Выборка.ИндексСтроки;
		
		Если Товары1С[ИндексСтроки].ТребуетсяОСУ  = Истина Или Товары1С[ИндексСтроки].ТребуетсяОСУВесовойТовар  = Истина
			
			Тогда
			
			Item = Items[ИндексСтроки];
			УПД_ЗаполнитьКодОСУ(Item, Выборка,сПараметры);
			
		ИначеЕсли Товары1С[ИндексСтроки].ТребуетсяОСУПартионныйУчет = Истина Тогда
			Item = Items[ИндексСтроки];
			ДобавитьНомерПроизводственнойПартии(item,Выборка,тНомераПартий,Ложь,ОшибкиВДанных);
		ИначеЕсли Товары1С[ИндексСтроки].ТребуетсяОСУВесовойТоварПартионныйУчет = Истина Тогда
			Item = Items[ИндексСтроки];
			ДобавитьНомерПроизводственнойПартии(item,Выборка,тНомераПартий,Истина,ОшибкиВДанных);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого с из тКоличествоОСУ Цикл
		Если с.КоличествоУпаковок <> 0 или с.КоличествоКодовОСУ <> 0 Тогда
			
			мОшибки.Добавить(СтрШаблон("Номенклатура %1, в реализации меньше на %2 единиц. В реализацию не попало %3 кодов ОСУ весового товара.",с.Номенклатура,с.КоличествоУпаковок,с.КоличествоКодовОСУ));
			
		КонецЕсли;
	КонецЦикла;
	
	Если мОшибки.Количество() <> 0 Тогда
		
		ТекстОшибок = "";
		Для Каждого эл из мОшибки Цикл
			ТекстОшибок = ТекстОшибок + Символы.ПС + эл;
		КонецЦикла;
		ЗаписьЖурналаРегистрации("ЕН.ОшибкаДиадок",УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибок);
		Сообщить(ТекстОшибок);
		ВызватьИсключение(ТекстОшибок);
		
	КонецЕсли;
	
КонецПроцедуры




