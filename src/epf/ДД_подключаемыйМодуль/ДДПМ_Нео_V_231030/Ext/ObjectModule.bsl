КонецПроцедуры


Процедура УКД_ЗаполнитьКодОСУ(Item, Выборка,сПараметры)
	тКоличествоОСУ = сПараметры.тКоличествоОСУ;
	мОшибки = сПараметры.мОшибки;
	GTIN = GTINТовара(Выборка);
	
	Если НЕ ЗначениеЗаполнено(GTIN) Тогда
		Возврат;
	КонецЕсли;
	
	// до изменения
	Если 	ЗначениеЗаполнено(Item.OriginalValues.Quantity)   Тогда
		КоличествоДоИзменения = Item.OriginalValues.Quantity;
		Если Выборка.ТребуетсяОСУВесовойТовар = Истина	Тогда
			с = тКоличествоОСУ.Найти(Выборка.Номенклатура,"Номенклатура");
			Если с = Неопределено Тогда
				мОшибки.Добавить(СтрШаблон("Номенклатура %1, не найдена информация об кодах ОСУ в документе.",Выборка.Номенклатура));
			Иначе
				КоличествоДоИзменения = Окр(с.КоличествоКодовОСУДо * Item.OriginalValues.Quantity / с.КоличествоУпаковокДо,0);
				Если КоличествоДоИзменения < 0 Тогда
					мОшибки.Добавить(СтрШаблон("Номенклатура %1, не верно получено количество кодов ОСУ до изменения %2.",Выборка.Номенклатура,КоличествоДоИзменения));
				КонецЕсли;
				с.КоличествоКодовОСУДо = с.КоличествоКодовОСУДо - КоличествоДоИзменения;
				с.КоличествоУпаковокДо = с.КоличествоУпаковокДо - Item.OriginalValues.Quantity;
				
				
			КонецЕсли;
			
		КонецЕсли;
		КодОСУ = "02" + GTIN + "37" + XMLСтрока(КоличествоДоИзменения);
		
		ItemIdentificationNumber = ОсновнойМодуль.НовыйЭлементСпискаXDTO(Item.OriginalItemIdentificationNumbers);
		
		ItemIdentificationNumber.PackageIds.Добавить(КодОСУ);
	КонецЕсли;
	
	// после изменения
	Если 	ЗначениеЗаполнено(Item.CorrectedValues.Quantity)     Тогда
		
		КоличествоПослеИзменения = Item.CorrectedValues.Quantity;
		
		Если Выборка.ТребуетсяОСУВесовойТовар = Истина	Тогда
			с = тКоличествоОСУ.Найти(Выборка.Номенклатура,"Номенклатура");
			Если с = Неопределено Тогда
				мОшибки.Добавить(СтрШаблон("Номенклатура %1, не найдена информация об кодах ОСУ в документе.",Выборка.Номенклатура));
			Иначе
				КоличествоПослеИзменения = Окр(с.КоличествоКодовОСУ * Item.CorrectedValues.Quantity / с.КоличествоУпаковок,0);
				Если КоличествоДоИзменения < 0 Тогда
					мОшибки.Добавить(СтрШаблон("Номенклатура %1, не верно получено количество кодов ОСУ после изменения %2.",Выборка.Номенклатура,КоличествоДоИзменения));
				КонецЕсли;
				с.КоличествоКодовОСУ = с.КоличествоКодовОСУ - КоличествоПослеИзменения;
				с.КоличествоУпаковок = с.КоличествоУпаковок - Item.CorrectedValues.Quantity;
				
				
			КонецЕсли;
			
		КонецЕсли;
		
		КодОСУ = "02" + GTIN + "37" + XMLСтрока(КоличествоПослеИзменения);
		ItemIdentificationNumber = ОсновнойМодуль.НовыйЭлементСпискаXDTO(Item.CorrectedItemIdentificationNumbers);
		ItemIdentificationNumber.PackageIds.Добавить(КодОСУ);
	КонецЕсли;
	
КонецПроцедуры

Процедура УКД_ЗаполнитьКодОСУПартионныйУчет(Item, Выборка,сПараметры)
	тДанныеПартионногоУчета = сПараметры.тДанныеПартионногоУчета;
	мОшибки = сПараметры.мОшибки;
	GTIN = GTINТовара(Выборка);
	
	Если НЕ ЗначениеЗаполнено(GTIN) Тогда
		Возврат;
	КонецЕсли;
	мДанныеПартионногоУчета = тДанныеПартионногоУчета.НайтиСтроки(Новый Структура("Номенклатура",Выборка.Номенклатура ));
	Если мДанныеПартионногоУчета.Количество() <> 1 Тогда
		мОшибки.Добавить(СтрШаблон("Номенклатура %1, нет информации об кодах партионного учета в документе.",Выборка.Номенклатура));
		Возврат;
	КонецЕсли;
	
	сДанныеПартионногоУчета = мДанныеПартионногоУчета[0];
	Если 	ЗначениеЗаполнено(Item.OriginalValues.Quantity)   Тогда
		КоличествоДоИзменения = Item.OriginalValues.Quantity;
		
		Если Выборка.ТребуетсяОСУВесовойТовар = Истина	Тогда
			КоличествоДоИзменения = сДанныеПартионногоУчета.КоличествоКодовОСУДо;
		КонецЕсли;
		КодОСУ = "02" + GTIN + "37" + XMLСтрока(КоличествоДоИзменения);
		
		ItemIdentificationNumber = ОсновнойМодуль.НовыйЭлементСпискаXDTO(Item.OriginalItemIdentificationNumbers);
		
		ItemIdentificationNumber.PackageIds.Добавить(КодОСУ);
		Если сДанныеПартионногоУчета.Серия.ДатаПроизводства >= '20261101' Тогда
			ЭлементСписка = ОсновнойМодуль.НовыйЭлементСпискаXDTO(Item.StructedAdditionalInfos);
			ЭлементСписка.Key = ИдентификаторПрПартМаркДо();
			ЭлементСписка.Value = СокрЛП(сДанныеПартионногоУчета.Серия.Номер);
		КонецЕсли;
	КонецЕсли;
	
	// после изменения
	Если 	ЗначениеЗаполнено(Item.CorrectedValues.Quantity)     Тогда
		КоличествоПослеИзменения = Item.CorrectedValues.Quantity;
		Если Выборка.ТребуетсяОСУВесовойТовар = Истина	Тогда
			КоличествоПослеИзменения = сДанныеПартионногоУчета.КоличествоОСУПосле;
		КонецЕсли;
		
		КодОСУ = "02" + GTIN + "37" + XMLСтрока(КоличествоПослеИзменения);
		ItemIdentificationNumber = ОсновнойМодуль.НовыйЭлементСпискаXDTO(Item.CorrectedItemIdentificationNumbers);
		
		ItemIdentificationNumber.PackageIds.Добавить(КодОСУ);
		Если сДанныеПартионногоУчета.Серия.ДатаПроизводства >= '20261101' Тогда
			ЭлементСписка = ОсновнойМодуль.НовыйЭлементСпискаXDTO(Item.StructedAdditionalInfos);
			ЭлементСписка.Key = ИдентификаторПрПартМаркПосле();
			ЭлементСписка.Value = СокрЛП(сДанныеПартионногоУчета.Серия.Номер);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


