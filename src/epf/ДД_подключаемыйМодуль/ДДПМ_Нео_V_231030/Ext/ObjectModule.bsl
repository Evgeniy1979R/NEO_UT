Процедура ДобавитьНомерПроизводственнойПартии(item,Выборка,тНомераПартий,ВесовойТовар,ОшибкиВДанных)
	
	НомераСтрокВнеРекомендованнойДлиныПартий = Новый Массив;
	мНомераПартий = тНомераПартий.НайтиСтроки( Новый Структура("Номенклатура,Количество",Выборка.Номенклатура,item.Quantity));
	Если мНомераПартий.Количество() = 0 Тогда
		ДобавитьОшибкуВДанных(ОшибкиВДанных,СтрШаблон("Не получилось определить номер партии товара %1, количество %2",Выборка.Номенклатура,item.Quantity));
	КонецЕсли;
	СписатьВсего = item.Quantity;
	GTIN = GTINТовара(Выборка);
	item.GTIN = GTIN;
	Для Каждого сНомераПартий из мНомераПартий Цикл
		Если СписатьВсего = 0 Тогда
			Прервать;
		ИначеЕсли сНомераПартий.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Списать = Мин(СписатьВсего,сНомераПартий.Количество);
		Если ВесовойТовар = истина Тогда
			
			ItemIdentificationNumber = ОсновнойМодуль.НовыйЭлементСпискаXDTO(Item.ItemIdentificationNumbers);
			Контент = "02" + GTIN + "37" + Формат(сНомераПартий.КоличествоЕдиницВесовогоТовара, "ЧГ=") + "3103" + Формат(Списать*1000,"ЧЦ=9; ЧВН=; ЧГ=");
			
			ItemIdentificationNumber.PackageIds.Добавить(Контент);
			
			Если сНомераПартий.КоличествоЕдиницВесовогоТовара = 0 Тогда
				ДобавитьОшибкуВДанных(ОшибкиВДанных,СтрШаблон("Не корректно указано количество единиц весового товара %1, количество %2",Выборка.Номенклатура,item.Quantity));
			КонецЕсли;
			
		Иначе
			ItemIdentificationNumber = ОсновнойМодуль.НовыйЭлементСпискаXDTO(Item.ItemIdentificationNumbers);
			ItemIdentificationNumber.MarkedItemsQuantity	 = Списать;
		КонецЕсли;
		
		Если ТипЗнч(сНомераПартий.ДатаПартии) = Тип("Дата") и сНомераПартий.ДатаПартии >= '20261101' Тогда
			
			ItemIdentificationNumber.BatchCode = сНомераПартий.НомерПартии;
			Если Не СоответствуетРекомендованнойДлинеПартии(сНомераПартий.НомерПартии) Тогда
				НомераСтрокВнеРекомендованнойДлиныПартий.Добавить(сНомераПартий.НомерПартии);
			КонецЕсли;
			
		КонецЕсли;
		
		
		СписатьВсего = СписатьВсего - Списать;
		сНомераПартий.Количество = сНомераПартий.Количество - Списать;
		
	КонецЦикла;
	ПоказатьПредупреждениеОНарушенияхРекомендованнойДлиныПартии(НомераСтрокВнеРекомендованнойДлиныПартий);
	
КонецПроцедуры

Процедура ПоказатьПредупреждениеОНарушенияхРекомендованнойДлиныПартии(НомераСтрок)
	
	Если НЕ ЗначениеЗаполнено(НомераСтрок) Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонПредупреждения = НСтр("ru='В строках %1 количество символов в ПрПартМарк отличается от рекомендуемой.
	|Согласно рекомендациям честного знака номер производственной партии должен иметь длину от 21 до 32 двух символов.'");
	
	РазделительЗначений = ", ";
	НомераСтрокой = СтрСоединить(НомераСтрок, РазделительЗначений);
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(ШаблонПредупреждения, НомераСтрокой);
	Сообщение.Сообщить();
	
КонецПроцедуры

Функция СоответствуетРекомендованнойДлинеПартии(ЗначениеПартии)
	
	МинимальноеЧислоСимволов = 21;
	МаксимальноеЧислоСимволов = 32;
	
	ЧислоСимволов = СтрДлина(ЗначениеПартии);
	
	Результат = (ЧислоСимволов >= МинимальноеЧислоСимволов И ЧислоСимволов <= МаксимальноеЧислоСимволов);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьОшибкуВДанных(ОшибкиВДанных, Знач ТекстОшибки)
	
	ИмяТипа = ОшибкиВДанных.ВладеющееСвойство.Тип.Имя;
	НовыйЭлементСписка = ОсновнойМодуль.ДД_Компонента_ПолучитьПустойКонтент(ИмяТипа, Истина);
	
	ТекстОшибки = ОсновнойМодуль.ЭДО_Служебные_ПодставитьПараметрыВСтроку(
	"Ошибки ""%1"":",ТекстОшибки);
	
	НовыйЭлементСписка.ТекстОшибки = ТекстОшибки;
	
	ОшибкиВДанных.Добавить(НовыйЭлементСписка);
	
КонецПроцедуры

