	|	ГДЕ
	|		КорректировкаРеализацииРасхождения.Ссылка = &ДокументСсылка
	|
	|	СГРУППИРОВАТЬ ПО
	|		КорректировкаРеализацииРасхождения.Номенклатура
	|
	|	ИМЕЮЩИЕ
	|		СУММА(КорректировкаРеализацииРасхождения.КоличествоКодовОСУ) <> 0) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	|		ПО ВложенныйЗапрос.Номенклатура = НоменклатураДополнительныеРеквизиты.Ссылка
	|			И (""ПризнакМаркировки_441f840d56794d87981804d4eeebc145"" = НоменклатураДополнительныеРеквизиты.Свойство.Имя)
	|ГДЕ
	|	НЕ ВЫРАЗИТЬ(НоменклатураДополнительныеРеквизиты.Значение КАК Справочник.ЗначенияСвойствОбъектов).Наименование В (""Молочные продукты партионный учет"", ""Молочные продукты весовой товар партионный учет"")
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Номенклатура";
	мРезультаты = Запрос.ВыполнитьПакет();
	тКоличествоОСУ = мРезультаты[мРезультаты.ВГраница()].Выгрузить();
	тДанныеПартионногоУчета = мРезультаты[мРезультаты.ВГраница()-1].Выгрузить();
	мОшибки = Новый Массив;
	сПараметры = Новый Структура("тКоличествоОСУ,мОшибки,тДанныеПартионногоУчета",тКоличествоОСУ,мОшибки,тДанныеПартионногоУчета );
	
	Пока Выборка.Следующий() Цикл
		
		ИндексСтроки = Выборка.ИндексСтроки;
		
		Если Товары1С[ИндексСтроки].ТребуетсяОСУ  = Истина 	или Товары1С[ИндексСтроки].ТребуетсяОСУВесовойТовар  = Истина	Тогда
			
			Item = Items[ИндексСтроки];
			
			УКД_ЗаполнитьКодОСУ(Item, Выборка,сПараметры);
		ИначеЕсли Товары1С[ИндексСтроки].ТребуетсяОСУПартионныйУчет = Истина Тогда
			Item = Items[ИндексСтроки];
			УКД_ЗаполнитьКодОСУПартионныйУчет(Item,Выборка,сПараметры);
		ИначеЕсли Товары1С[ИндексСтроки].ТребуетсяОСУВесовойТоварПартионныйУчет = Истина Тогда
			Item = Items[ИндексСтроки];
			УКД_ЗаполнитьКодОСУПартионныйУчет(Item,Выборка,сПараметры);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого с из тКоличествоОСУ Цикл
		Если с.КоличествоУпаковок <> 0 или с.КоличествоКодовОСУ <> 0 или
			с.КоличествоУпаковокДо <> 0 или с.КоличествоКодовОСУДо <> 0 Тогда
			
			мОшибки.Добавить(СтрШаблон("Номенклатура %1, не распределено %2 единиц. не распределено %3 кодов ОСУ весового товара.
			| не распределено %4 единиц до. не распределено %5 кодов ОСУ весового товара до.",с.Номенклатура,с.КоличествоУпаковок,с.КоличествоКодовОСУ,
			с.КоличествоУпаковокДо, с.КоличествоКодовОСУДо));
		КонецЕсли;
	КонецЦикла;
	
	Если мОшибки.Количество() <> 0 Тогда
		ТекстОшибок = "";
		Для Каждого эл из мОшибки Цикл
			ТекстОшибок = ТекстОшибок + Символы.ПС + эл;
		КонецЦикла;
		ЗаписьЖурналаРегистрации("ЕН.ОшибкаДиадок",УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибок);
		Сообщить(ТекстОшибок);
		ВызватьИсключение(ТекстОшибок);
	КонецЕсли;
	
КонецПроцедуры

