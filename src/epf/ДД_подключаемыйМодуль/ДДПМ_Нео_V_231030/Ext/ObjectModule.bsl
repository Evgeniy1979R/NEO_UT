Функция GTINТовара(Выборка)
	
	
	GTIN = НормализоватьШК(Выборка.Штрихкод);
	
	Если СтрДлина(GTIN)  = 13 Тогда
		GTIN = "0"   + GTIN;
	КонецЕсли;
	
	Возврат GTIN;
	
КонецФункции

Процедура УПД_ЗаполнитьКодОСУ(Item, Выборка,сПараметры	)
	
	тКоличествоОСУ = сПараметры.тКоличествоОСУ;
	мОшибки = сПараметры.мОшибки;
	мНайденныеСтроки = тКоличествоОСУ.НайтиСтроки(Новый Структура("Номенклатура",Выборка.Номенклатура ));
	КоличествоОСУ = 0;
	Если мНайденныеСтроки.Количество() = 1 Тогда
		Если Выборка.ТребуетсяОСуВесовойТовар = Ложь Тогда
			мОшибки.Добавить(СтрШаблон("Номенклатура %1, заполнены коды ОСУ для весового товара. Товар не помечен как весовой.",Выборка.Номенклатура));
		Иначе
			Если  Item.Quantity > мНайденныеСтроки[0].КоличествоУпаковок Тогда
				мОшибки.Добавить(СтрШаблон("Номенклатура %1, количество в реализации больше чем в заказе.",Выборка.Номенклатура));
			Иначе
				КоличествоОСУ = Окр(мНайденныеСтроки[0].КоличествоКодовОСУ * Item.Quantity / мНайденныеСтроки[0].КоличествоУпаковок,0);
				мНайденныеСтроки[0].КоличествоКодовОСУ = мНайденныеСтроки[0].КоличествоКодовОСУ - КоличествоОСУ;
				мНайденныеСтроки[0].КоличествоУпаковок = мНайденныеСтроки[0].КоличествоУпаковок - Item.Quantity;
				Если КоличествоОСУ = 0 Тогда
					мОшибки.Добавить(СтрШаблон("Номенклатура %1, проверьте все строки реализации. В одну из строк не удалось подобрать коды ОСУ для весового товара.",Выборка.Номенклатура));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		Если Выборка.ТребуетсяОСуВесовойТовар = Истина Тогда
			мОшибки.Добавить(СтрШаблон("Номенклатура %1, не найдены коды осу весового товара для %2 единиц.",Выборка.Номенклатура,Item.Quantity));
		КонецЕсли;
	КонецЕсли;
	
	GTIN = GTINТовара(Выборка);
	Если НЕ ЗначениеЗаполнено(GTIN) Тогда
		Возврат;
	КонецЕсли;
	
	Если КоличествоОСУ > 0 Тогда
		Количество = КоличествоОСУ;
	Иначе
		Количество = Item.Quantity;
	КонецЕсли;
	
	КодОСУ = "02" + GTIN + "37" + XMLСтрока(Количество);
	
	ItemIdentificationNumber = ОсновнойМодуль.НовыйЭлементСпискаXDTO(Item.ItemIdentificationNumbers);
	
	ItemIdentificationNumber.PackageIds.Добавить(КодОСУ);
	
КонецПроцедуры

