Функция ДанныеТоваров1С(Items)
	
	Результат = Новый ТаблицаЗначений;
	Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Признак маркировки");
	
	Результат.Колонки.Добавить("ИндексСтроки"	, Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Номенклатура"	, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Характеристика"	, Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Результат.Колонки.Добавить("Упаковка"		, Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Результат.Колонки.Добавить("ТребуетсяОСУ"		, Новый ОписаниеТипов("Булево"));
	//{нев}
	Результат.Колонки.Добавить("ТребуетсяОСУВесовойТовар"		, Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ТребуетсяОСУПартионныйУчет"		, Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ТребуетсяОСУВесовойТоварПартионныйУчет"		, Новый ОписаниеТипов("Булево"));
	//{нев}
	
	ИндексСтроки = 0;
	
	Для Каждого Item Из Items Цикл
		
		СлужебнаяИнформация = ОсновнойМодуль.ОбъектXDTOВСтруктуру(Item.СлужебнаяИнформация);
		
		НоваяСтрока = Результат.Добавить();
		
		НоваяСтрока.ИндексСтроки				= ИндексСтроки;
		НоваяСтрока.Номенклатура				= СлужебнаяИнформация.Номенклатура;
		НоваяСтрока.Характеристика 				= СлужебнаяИнформация.Характеристика;
		НоваяСтрока.Упаковка 					= СлужебнаяИнформация.Упаковка;
		//{нев}
		НоваяСтрока.ТребуетсяОСУ 				= Ложь;
		НоваяСтрока.ТребуетсяОСУВесовойТовар 	= Ложь;
		НоваяСтрока.ТребуетсяОСУПартионныйУчет 	= Ложь;
		НоваяСтрока.ТребуетсяОСУВесовойТоварПартионныйУчет 	= Ложь;
		//{нев}
		
		Признак = УправлениеСвойствами.ЗначениеСвойства(СлужебнаяИнформация.Номенклатура, ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Признак маркировки"));
		
		Если Признак <> Неопределено И Признак.Наименование  = "Молочные продукты"  Тогда
			
			НоваяСтрока.ТребуетсяОСУ 		= Истина;
		ИначеЕсли Признак <> Неопределено И Признак.Наименование  = "Молочные продукты весовой товар"  Тогда
			НоваяСтрока.ТребуетсяОСУВесовойТовар = Истина;
		ИначеЕсли Признак <> Неопределено и Признак.Наименование = "Молочные продукты партионный учет" Тогда
			НоваяСтрока.ТребуетсяОСУПартионныйУчет = Истина;
		ИначеЕсли Признак <> Неопределено и Признак.Наименование = "Молочные продукты весовой товар партионный учет" Тогда
			НоваяСтрока.ТребуетсяОСУВесовойТоварПартионныйУчет = Истина;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

