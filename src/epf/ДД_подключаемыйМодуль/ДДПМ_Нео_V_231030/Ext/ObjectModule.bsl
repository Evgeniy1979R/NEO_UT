Функция НормализоватьШК(ШК)
	
	Если СтрДлина(Шк) < 2 Тогда
		
		Возврат ШК;
		
	КонецЕсли;
	
	НовыйШК = СокрЛП(ШК);
	
	Если Прав(ШК,1) = "_" Тогда
		НовыйШК = Лев(НовыйШК,СтрДлина(НовыйШК)-2);
	КонецЕсли;
	
	Возврат НовыйШК;
	
КонецФункции



