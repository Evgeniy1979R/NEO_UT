Перем ОсновнойМодуль Экспорт;

Функция ОбработатьСобытие(ИмяСобытия, Параметры) Экспорт
	
	Если ИмяСобытия = "ПодготовитьЭлектронныйДокумент" Тогда
		
		Возврат ПодготовитьЭлектронныйДокумент(Параметры);
	ИначеЕсли ИмяСобытия = "ПолучитьЗаполненныйОбъектДокумента1С" Тогда
		#Область new_231122_1409_
		ПолучитьЗаполненныйОбъектДокумента1С(Параметры);
		#КонецОбласти
	КонецЕсли;
	
КонецФункции
#Область new_231122_1409_

Процедура ПолучитьЗаполненныйОбъектДокумента1С(Параметры)
	ИдентификаторОперации = Неопределено;
	РезультатИМ = Неопределено;
	ОсновнойОбъект = Неопределено;
	Параметры.Свойство("ИдентификаторОперации",ИдентификаторОперации);
	Если ИдентификаторОперации <> "ПриобретениеТоваровУслуг"
		или Параметры.Свойство("Результат_ИМ",РезультатИМ) = Ложь
		или ТипЗнч(РезультатИМ) <> Тип("Структура")
		Или РезультатИМ.Свойство("ОсновнойОбъект",ОсновнойОбъект) = Ложь
		Или ТипЗнч(ОсновнойОбъект) <> Тип("ДокументОбъект.ПриобретениеТоваровУслуг")
		Тогда
		Возврат;
	КонецЕсли;
	
	
	#Область new_231122_1134_
	Запрос = Новый	 Запрос;
	Запрос.УстановитьПараметр("Свойство",РеквизитПоУмолчанию());
	Запрос.УстановитьПараметр("ДатаНачалаДействия",?(ОсновнойОбъект.Дата = '00010101',НачалоДня(ТекущаяДата()),НачалоДня(ОсновнойОбъект.Дата)));
	Запрос.УстановитьПараметр("ДатаОкончанияДействия",?(ОсновнойОбъект.Дата = '00010101',КонецДня(ТекущаяДата()),КонецДня(ОсновнойОбъект.Дата)));
	Запрос.УстановитьПараметр("Организация",ОсновнойОбъект.Организация);
	Запрос.УстановитьПараметр("ТипДоговора",ПредопределенноеЗначение("Перечисление.ТипыДоговоров.СПоставщиком"));
	Запрос.УстановитьПараметр("Партнер", ОсновнойОбъект.Партнер);
	Запрос.УстановитьПараметр("Контрагент", ОсновнойОбъект.Контрагент);
	Запрос.Текст = "ВЫБРАТЬ
	|	СоглашенияСПоставщикамиДополнительныеРеквизиты.Ссылка КАК Соглашение
	|ИЗ
	|	Справочник.СоглашенияСПоставщиками.ДополнительныеРеквизиты КАК СоглашенияСПоставщикамиДополнительныеРеквизиты
	|ГДЕ
	|	СоглашенияСПоставщикамиДополнительныеРеквизиты.Свойство = &Свойство
	|	И СоглашенияСПоставщикамиДополнительныеРеквизиты.Ссылка.ДатаНачалаДействия <= &ДатаНачалаДействия
	|	И (СоглашенияСПоставщикамиДополнительныеРеквизиты.Ссылка.ДатаОкончанияДействия >= &ДатаОкончанияДействия
	|			ИЛИ СоглашенияСПоставщикамиДополнительныеРеквизиты.Ссылка.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1))
	|	И СоглашенияСПоставщикамиДополнительныеРеквизиты.Ссылка.Организация = &Организация
	|	И СоглашенияСПоставщикамиДополнительныеРеквизиты.Значение = Истина
	|	И СоглашенияСПоставщикамиДополнительныеРеквизиты.Ссылка.Партнер = &Партнер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДоговорыКонтрагентовДополнительныеРеквизиты.Ссылка КАК Договор
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов.ДополнительныеРеквизиты КАК ДоговорыКонтрагентовДополнительныеРеквизиты
	|ГДЕ
	|	ДоговорыКонтрагентовДополнительныеРеквизиты.Свойство = &Свойство
	|	И ДоговорыКонтрагентовДополнительныеРеквизиты.Значение = ИСТИНА
	|	И ДоговорыКонтрагентовДополнительныеРеквизиты.Ссылка.Организация = &Организация
	|	И ДоговорыКонтрагентовДополнительныеРеквизиты.Ссылка.ДатаНачалаДействия <= &ДатаНачалаДействия
	|	И (ДоговорыКонтрагентовДополнительныеРеквизиты.Ссылка.ДатаОкончанияДействия >= &ДатаОкончанияДействия
	|			ИЛИ ДоговорыКонтрагентовДополнительныеРеквизиты.Ссылка.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1))
	|	И ДоговорыКонтрагентовДополнительныеРеквизиты.Ссылка.ТипДоговора = &ТипДоговора
	|	И ДоговорыКонтрагентовДополнительныеРеквизиты.Ссылка.Контрагент = &Контрагент";
	мРезультаты = Запрос.ВыполнитьПакет();
	ВыборкаСоглашения 	= мРезультаты[0].Выбрать();
	ВыборкаДоговоры 	= мРезультаты[1].Выбрать();
	Если ВыборкаСоглашения.Количество() = 1 Тогда
		ВыборкаСоглашения.Следующий();
		ОсновнойОбъект.Соглашение = ВыборкаСоглашения.Соглашение;
	КонецЕсли;
	
	Если ВыборкаДоговоры.Количество() = 1 Тогда
		ВыборкаДоговоры.Следующий();
		ОсновнойОбъект.Договор = ВыборкаДоговоры.Договор;
		//		ДоговорПриИзмененииСервер();
	КонецЕсли;
	ОсновнойОбъект.Склад = Справочники.Склады.ПолучитьСсылку(
	Новый УникальныйИдентификатор("f1f450bd-371d-11e9-80f5-00155d049bbe"));//Справочники.Склады.НайтиПоНаименованию("Алексеевка Наро-Фоминск 1",Истина);
	
	Для Каждого сТовары из ОсновнойОбъект.Товары Цикл
		сТовары.Склад = ОсновнойОбъект.Склад;
	КонецЦикла;
	ОсновнойОбъект.ЗаполнитьЭтапыГрафикаОплаты();
	ОсновнойОбъект.ОбменДанными.Загрузка = Ложь;
	ОсновнойОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МИНИМУМ(СчетФактураПолученныйДокументыОснования.Ссылка) КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураПолученный.ДокументыОснования КАК СчетФактураПолученныйДокументыОснования
	|ГДЕ
	|	СчетФактураПолученныйДокументыОснования.ДокументОснование = &ДокументОснование";
	Запрос.УстановитьПараметр("ДокументОснование", ОсновнойОбъект.ССылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		оДокументСчетФактура = Выборка.Ссылка.ПолучитьОбъект();
		оДокументСчетФактура.Организация = ОсновнойОбъект.Организация;
		оДокументСчетФактура.Контрагент = ОсновнойОбъект.Контрагент;
		оДокументСчетФактура.КППКонтрагента = оДокументСчетФактура.Контрагент.ИНН;
		оДокументСчетФактура.ИННКонтрагента = оДокументСчетФактура.Контрагент.КПП;
		оДокументСчетФактура.ПометкаУдаления = Ложь;
		оДокументСчетФактура.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	#КонецОбласти
	//++НЕВ
	СтрокаКомментарий = "";
	Попытка
		Для Каждого эл из Параметры.Документ.СлужебнаяИнформация.Контент.table.items Цикл
			т = СтрШаблон("%1;ГТИН: %2;",эл.Product,эл.GTIN);
			Для Каждого элItemIdentificationNumbers	из эл.ItemIdentificationNumbers Цикл
				т = СтрШаблон("%1
				|		Партия: %2; Количество: %3",т,элItemIdentificationNumbers.BatchCode, элItemIdentificationNumbers.MarkedItemsQuantity	);
			КонецЦикла;
			СтрокаКомментарий = СтрокаКомментарий + ?(СтрокаКомментарий = "","",Символы.ПС)+т;
		КонецЦикла;
		
	Исключение
		
	КонецПопытки;
	ОсновнойОбъект.Комментарий = ОсновнойОбъект.Комментарий + СтрокаКомментарий;
	//--НЕВ
	
	
КонецПроцедуры
#КонецОбласти
// Обработчики событий подключаемого модуля

Функция ПодготовитьЭлектронныйДокумент(Параметры)
	
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Результат_ИМ") Тогда
		
		Content		= Параметры.Результат.Content;
		Документ1С 	= Параметры.Результат.Документ1С;
		
		ВидДокументаРазвернутый = Параметры.ВидДокументаРазвернутый;
		
		ТипКонтента_XDTO = ВидДокументаРазвернутый.ТипКонтента;
		
		Если ВРЕГ(ТипКонтента_XDTO) = ВРЕГ("Utd820SellerContent")
			или ВРЕГ(ТипКонтента_XDTO) = ВРЕГ("Utd970SellerContent")
			Тогда
			
			УПД_ИзменитьДанныеТоваров(Content, Документ1С);
			УПД_ИзменитьНомераДокументов(Content, Документ1С);
			
			
		КонецЕсли;
		
		Если ВРЕГ(ТипКонтента_XDTO) = ВРЕГ("UcdSellerContent") Тогда
			
			УКД_ИзменитьДанныеТоваров(Content, Документ1С);
			УКД_ИзменитьНомераДокументов(Content, Документ1С);
			
			
		КонецЕсли;
		
		Возврат Истина;
		
	КонецЕсли;
	
	
КонецФункции

Процедура УПД_ИзменитьНомераДокументов(Content, Документ1С)
	
	Content.Buyers.Владелец.DocumentNumber =   стрЗаменить(Content.Buyers.Владелец.DocumentNumber,"УТ-","");
	
	УПД_ИзменитьНомерДокумента(Content);
	
	УПД_ИзменитьНомераДокументовОтгрузки(Content);
	
	УПД_ИзменитьНомераДокументовОснованийОтгрузки(Content);
	
	УПД_ИзменитьНомераТранспортныхНакладных(Content);
	
	
	
КонецПроцедуры

Процедура УПД_ИзменитьНомерДокумента(Content)
	
	Номер = УПД_НомерДокумента(Content);
	
	НовыйНомер =стрЗаменить(Номер,"УТ-","") ;
	
	УПД_ЗаполнитьОсновныеРеквизиты(Content, НовыйНомер);
	
КонецПроцедуры

Функция УПД_НомерДокумента(Content)
	
	Возврат Content.DocumentNumber;
	
КонецФункции

Процедура УПД_ЗаполнитьОсновныеРеквизиты(Content, Номер = Неопределено, Дата = Неопределено, НаименованиеДокумента = Неопределено)
	
	Если ЗначениеЗаполнено(Номер) Тогда
		Content.DocumentNumber = Номер;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Дата) Тогда
		Content.DocumentDate = Дата;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаименованиеДокумента) Тогда
		Content.DocumentName = НаименованиеДокумента;
	КонецЕсли;
	
КонецПроцедуры


Процедура УПД_ИзменитьНомераДокументовОтгрузки(Content)
	
	ВсегоДокументов = УПД_ДокументыОтгрузки_КоличествоВКоллекции(Content);
	
	Если ВсегоДокументов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МаксИндекс = ВсегоДокументов - 1;
	
	Для инд = 0 По МаксИндекс Цикл
		
		ДокументОтгрузки = УПД_ДокументОтгрузкиПоИндексуВКоллекции(Content, инд);
		
		Номер = УПД_ДокументОтгрузки_НомерДокумента(ДокументОтгрузки);
		
		Если НЕ ЗначениеЗаполнено(Номер) Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйНомер =стрЗаменить(Номер,"УТ-","") ;
		
		
		УПД_ДокументОтгрузки_ЗаполнитьДанные(ДокументОтгрузки,, НовыйНомер);
		
	КонецЦикла;
	
КонецПроцедуры


Процедура УПД_ИзменитьНомераДокументовОснованийОтгрузки(Content)
	
	ВсегоДокументов = УПД_ОснованияОтгрузки_КоличествоВКоллекции(Content);
	
	Если ВсегоДокументов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МаксИндекс = ВсегоДокументов - 1;
	
	Для инд = 0 По МаксИндекс Цикл
		
		ОснованиеОтгрузки = УПД_ОснованиеОтгрузкиПоИндексуВКоллекции(Content, инд);
		
		Номер = УПД_ОснованиеОтгрузки_НомерДокумента(ОснованиеОтгрузки);
		
		Если НЕ ЗначениеЗаполнено(Номер) Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйНомер =стрЗаменить(Номер,"УТ-","");
		
		
		УПД_ОснованиеОтгрузки_ЗаполнитьДанные(ОснованиеОтгрузки,,, НовыйНомер);
		
	КонецЦикла;
	
КонецПроцедуры

Функция УПД_ОснованияОтгрузки_КоличествоВКоллекции(Content)
	
	TransferBases = Content.TransferInfo.TransferBases;
	
	Возврат TransferBases.Количество();
	
КонецФункции

Функция УПД_ОснованиеОтгрузки_НомерДокумента(TransferBase)
	
	Результат = Неопределено;
	
	Если TransferBase = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	сТмп = Новый Структура;
	сТмп.Вставить("DocumentNumber",Неопределено);
	ЗаполнитьЗначенияСвойств(сТмп,TransferBase);
	Результат = сТмп.DocumentNumber;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД_ИзменитьНомераТранспортныхНакладных(Content)
	
	ВсегоДокументов = УПД_ТранспортныеНакладные_КоличествоВКоллекции(Content);
	
	Если ВсегоДокументов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МаксИндекс = ВсегоДокументов - 1;
	
	Для инд = 0 По МаксИндекс Цикл
		
		ТранспортнаяНакладная = УПД_ТранспортнаяНакладнаяПоИндексуВКоллекции(Content, инд);
		
		Номер = УПД_ТранспортнаяНакладная_НомерДокумента(ТранспортнаяНакладная);
		
		Если НЕ ЗначениеЗаполнено(Номер) Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйНомер =стрЗаменить(Номер,"УТ-","");
		
		
		УПД_ТранспортнаяНакладная_ЗаполнитьДанные(ТранспортнаяНакладная,, НовыйНомер);
		
	КонецЦикла;
	
КонецПроцедуры

Функция УПД_ТранспортныеНакладные_КоличествоВКоллекции(Content)
	
	Результат = 0;
	сТмп = Новый Структура;
	сТмп.Вставить("Waybills",Неопределено);
	ЗаполнитьЗначенияСвойств(сТмп,Content.TransferInfo);
	Если ТипЗнч(сТмп.Waybills) = Тип("СписокXDTO") Тогда
		Результат = 	сТмп.Waybills.Количество();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД_ОснованиеОтгрузкиПоИндексуВКоллекции(Content, ИндексВКоллекции)
	
	TransferBases = Content.TransferInfo.TransferBases;
	
	Возврат ЭлементКоллекцииПоИндексуВКоллекции(TransferBases, ИндексВКоллекции);
	
КонецФункции

Процедура УПД_ОснованиеОтгрузки_ЗаполнитьДанные(TransferBase, Наименование = Неопределено, Дата = Неопределено, Номер = Неопределено, ДопИнформация = Неопределено)
	
	Если TransferBase = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		TransferBase.DocumentName = Наименование;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Дата) Тогда
		TransferBase.DocumentDate = Дата;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Номер) Тогда
		TransferBase.DocumentNumber	= Номер;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДопИнформация) Тогда
		TransferBase.DocumentInfo = ДопИнформация;
	КонецЕсли;
	
КонецПроцедуры

Функция ЭлементКоллекцииПоИндексуВКоллекции(Коллекция, ИндексВКоллекции)
	
	Результат = Неопределено;
	
	НомерВКоллекции = ИндексВКоллекции + 1;
	
	Если Коллекция.Количество() < НомерВКоллекции Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Коллекция[ИндексВКоллекции];
	
	Возврат Результат;
	
КонецФункции

Функция УКД_НомерДокумента(Content)
	
	Возврат Content.Number;
	
КонецФункции

Процедура УКД_ИзменитьНомераДокументов(Content, Документ1С)
	
	УКД_ИзменитьНомерДокумента(Content);
	
	УКД_ИзменитьНомераКорректируемыхСчетовФактур(Content);
	
	УКД_ИзменитьНомераОснованийКорректировки(Content);
	
	УКД_ИзменитьНомераПередаточныхДокументов(Content);
	
КонецПроцедуры

Процедура УКД_ИзменитьНомерДокумента(Content)
	
	Номер = УКД_НомерДокумента(Content);
	
	НовыйНомер = стрЗаменить(Номер,"УТ-","");
	
	УКД_ЗаполнитьОсновныеРеквизиты(Content, НовыйНомер);
	
КонецПроцедуры

Процедура УКД_ИзменитьНомераКорректируемыхСчетовФактур(Content)
	
	ВсегоДокументов = УКД_КорректируемыеСчетаФактуры_КоличествоВКоллекции(Content);
	
	Если ВсегоДокументов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МаксИндекс = ВсегоДокументов - 1;
	
	Для инд = 0 По МаксИндекс Цикл
		
		СчетФактура = УКД_КорректируемаяСчетФактураПоИндексуВКоллекции(Content, инд);
		
		Номер = УКД_КорректируемаяСчетФактура_НомерДокумента(СчетФактура);
		
		Если НЕ ЗначениеЗаполнено(Номер) Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйНомер = стрЗаменить(Номер,"УТ-","");
		
		УКД_КорректируемаяСчетФактура_ЗаполнитьДанные(СчетФактура,, НовыйНомер);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УКД_ИзменитьНомераОснованийКорректировки(Content)
	
	ВсегоДокументов = УКД_ОснованияКорректировки_КоличествоВКоллекции(Content);
	
	Если ВсегоДокументов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МаксИндекс = ВсегоДокументов - 1;
	
	Для инд = 0 По МаксИндекс Цикл
		
		ОснованиеКорректировки = УКД_ОснованиеКорректировкиПоИндексуВКоллекции(Content, инд);
		
		Номер = УКД_ОснованиеКорректировки_НомерДокумента(ОснованиеКорректировки);
		
		Если НЕ ЗначениеЗаполнено(Номер) Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйНомер = стрЗаменить(Номер,"УТ-","");
		
		
		УКД_ОснованиеКорректировки_ЗаполнитьДанные(ОснованиеКорректировки,,, НовыйНомер);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УКД_ИзменитьНомераПередаточныхДокументов(Content)
	
	ВсегоДокументов = УКД_ПередаточныеДокументы_КоличествоВКоллекции(Content);
	
	Если ВсегоДокументов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МаксИндекс = ВсегоДокументов - 1;
	
	Для инд = 0 По МаксИндекс Цикл
		
		ДокументОтгрузки = УКД_ПередаточныйДокументПоИндексуВКоллекции(Content, инд);
		
		Номер = УКД_ПередаточныйДокумент_НомерДокумента(ДокументОтгрузки);
		
		Если НЕ ЗначениеЗаполнено(Номер) Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйНомер = стрЗаменить(Номер,"УТ-","");
		
		УКД_ПередаточныйДокумент_ЗаполнитьДанные(ДокументОтгрузки,,, НовыйНомер);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД_ДокументОтгрузки_ЗаполнитьДанные(DocumentShipment, Наименование = Неопределено, Номер = Неопределено, Дата = Неопределено)
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		DocumentShipment.Name = Наименование;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Номер) Тогда
		DocumentShipment.Number	= Номер;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Дата) Тогда
		DocumentShipment.Date = Дата;
	КонецЕсли;
	
КонецПроцедуры

Функция УПД_ДокументОтгрузки_НомерДокумента(DocumentShipment)
	
	Результат = Неопределено;
	
	Если DocumentShipment = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = DocumentShipment.Number;
	
	Возврат Результат;
	
КонецФункции


Функция УПД_ДокументыОтгрузки_КоличествоВКоллекции(Content)
	
	DocumentShipments = Content.DocumentShipments;
	
	Возврат DocumentShipments.Количество();
	
