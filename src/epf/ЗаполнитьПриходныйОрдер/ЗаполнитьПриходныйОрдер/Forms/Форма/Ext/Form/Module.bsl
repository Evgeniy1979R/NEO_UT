
&НаКлиенте
Процедура Заполнить(Команда)
	
	ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
	ФормаДокумента = ПолучитьФорму("Документ.ПриходныйОрдерНаТовары.Форма.ФормаДокумента", ПараметрыФормы);
	
	//ОбъектДокумент = ФормаДокумента.Объект;
	ПараметрыВыполнения = Новый Структура("ЭтаФорма",ФормаДокумента);
	ЗаполнитьНаСервере(СсылкаНАОбъект);
	//КопироватьДанныеФормы(ОбъектДокумент,ФормаДокумента.Объект);
	ФормаДокумента.Открыть();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере(ссылка)
	ВидНоменклатурыМолочныеПродуктыСоСрокамиГодности = Справочники.ВидыНоменклатуры.ПолучитьСсылку( Новый УникальныйИдентификатор
	("adf21a2e-9c9b-11e7-80e1-00155d049bbe"));//Молочные продукты со сроками годности: e1cib/data/Справочник.ВидыНоменклатуры?ref=80e100155d049bbe11e79c9badf21a2e
	
	_Объект = Ссылка.Получитьобъект();
	Распоряжение = _Объект.Распоряжение;
	Отправитель = _Объект.Отправитель;
	Товары = _Объект.Товары;
	Ссылка = _Объект.Ссылка;
	Склад = _Объект.Склад;
	Дата = _Объект.Дата;
	Помещение = _Объект.Помещение;
	ДатаПоступления = ТекущаяДата();
	ЗаполнитьТоварыПоТоварамКПоступлению("НоменклатураКоличество",ДатаПоступления,_Объект);
	//Заполнение серий      
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПриобретениеТоваровУслугДополнительныеРеквизиты.Ссылка КАК Ссылка,
	               |	ПриобретениеТоваровУслугДополнительныеРеквизиты.НомерСтроки КАК НомерСтроки,
	               |	ПриобретениеТоваровУслугДополнительныеРеквизиты.Свойство КАК Свойство,
	               |	ПриобретениеТоваровУслугДополнительныеРеквизиты.Значение КАК Значение,
	               |	ПриобретениеТоваровУслугДополнительныеРеквизиты.ТекстоваяСтрока КАК ТекстоваяСтрока,
	               |	ПриобретениеТоваровУслугДополнительныеРеквизиты.Свойство.Имя КАК СвойствоИмя
	               |ИЗ
	               |	Документ.ПриобретениеТоваровУслуг.ДополнительныеРеквизиты КАК ПриобретениеТоваровУслугДополнительныеРеквизиты
	               |ГДЕ
	               |	ПриобретениеТоваровУслугДополнительныеРеквизиты.Ссылка = &Распоряжение";
	Запрос.УстановитьПараметр("Распоряжение", Распоряжение);
	Выборка = Запрос.Выполнить().Выбрать();
	//УстановитьЗначениеДопРеквизита(ОсновнойОбъект,"Партии1_84c8c15ed62c481ea5e321635572eb94",Лев(СтрокаJson,1024));
	//УстановитьЗначениеДопРеквизита(ОсновнойОбъект,"Партии2_0a98b0c662ab48808532c9993e4ecda7",Сред(СтрокаJson,1025,1024));
	//УстановитьЗначениеДопРеквизита(ОсновнойОбъект,"Партии3_279b8799f2554af6a35f10611a99096e",Сред(СтрокаJson,2049,1024));
	//[
	//    {
	//        "gtin": "04680000192903",
	//        "part": "046800001929032611091",
	//        "quant": 15120
	//    },
	//    {
	//        "gtin": "04680000192484",
	//        "part": "046800001924842611091",
	//        "quant": 14040
	//    },
	//    {
	//        "gtin": "04680000193924",
	//        "part": "046800001939242611091",
	//        "quant": 3760
	//    },
	//    {
	//        "gtin": "04680000193917",
	//        "part": "046800001939172611091",
	//        "quant": 1600
	//    }
	//]
	Партии1 = ""; Партии2="";Партии3="";
	Пока Выборка.Следующий() Цикл
		Если Выборка.свойствоИмя= "Партии1_84c8c15ed62c481ea5e321635572eb94" Тогда
			Партии1 = Выборка.Значение;
		ИначеЕсли Выборка.свойствоИмя= "Партии2_0a98b0c662ab48808532c9993e4ecda7" Тогда
			Партии2 = Выборка.Значение;
		ИначеЕсли Выборка.свойствоИмя= "Партии3_279b8799f2554af6a35f10611a99096e" Тогда
			Партии3 = Выборка.Значение;
		КонецЕсли;
	КонецЦикла;
	Чтениеjson = Новый ЧтениеJSON;
	Чтениеjson.УстановитьСтроку(Партии1+Партии2+Партии3);
	мПартии = ПрочитатьJSON(Чтениеjson);
	
	отСтрока = Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(150,ДопустимаяДлина.Переменная));
	отЧисло15_13 = Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,3,ДопустимыйЗнак.Неотрицательный));
	отДата	= Новый ОписаниеТипов("Дата",,Новый КвалификаторыДаты(ЧастиДаты.Дата));
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("тТовары", Товары);
	Запрос.Текст = "ВЫБРАТЬ
	|	тТовары.Номенклатура КАК Номенклатура,
	|	тТовары.Характеристика КАК Характеристика,
	|	тТовары.Назначение КАК Назначение,
	|	тТовары.Упаковка КАК Упаковка,
	|	тТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	тТовары.Количество КАК Количество,
	|	тТовары.СтатусУказанияСерий КАК СтатусУказанияСерий,
	|	тТовары.ДокументОтгрузки КАК ДокументОтгрузки,
	|	тТовары.УпаковочныйЛист КАК УпаковочныйЛист,
	|	тТовары.УпаковочныйЛистРодитель КАК УпаковочныйЛистРодитель,
	|	тТовары.Штрихкод КАК Штрихкод,
	|	тТовары.ЭтоУпаковочныйЛист КАК ЭтоУпаковочныйЛист,
	|	тТовары.ЭтоСлужебнаяСтрокаПустогоУпаковочногоЛиста КАК ЭтоСлужебнаяСтрокаПустогоУпаковочногоЛиста,
	|	тТовары.Комментарий КАК Комментарий,
	|	тТовары.Серия КАК Серия
	|ПОМЕСТИТЬ тТовары
	|ИЗ
	|	&тТовары КАК тТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тТовары.Номенклатура КАК Номенклатура,
	|	тТовары.Характеристика КАК Характеристика,
	|	тТовары.Назначение КАК Назначение,
	|	тТовары.Упаковка КАК Упаковка,
	|	тТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	тТовары.Количество КАК Количество,
	|	тТовары.СтатусУказанияСерий КАК СтатусУказанияСерий,
	|	тТовары.ДокументОтгрузки КАК ДокументОтгрузки,
	|	тТовары.УпаковочныйЛист КАК УпаковочныйЛист,
	|	тТовары.УпаковочныйЛистРодитель КАК УпаковочныйЛистРодитель,
	|	тТовары.Штрихкод КАК Штрихкод,
	|	тТовары.ЭтоУпаковочныйЛист КАК ЭтоУпаковочныйЛист,
	|	тТовары.ЭтоСлужебнаяСтрокаПустогоУпаковочногоЛиста КАК ЭтоСлужебнаяСтрокаПустогоУпаковочногоЛиста,
	|	тТовары.Комментарий КАК Комментарий,
	|	тТовары.Серия КАК Серия,
	|	ЛЕВ(ЕСТЬNULL(ВложенныйЗапрос.Штрихкод, """"), 13) КАК ШтрихкодНоменклатуры,
	|	ВложенныйЗапрос.Номенклатура.СрокГодности КАК СрокГодности,
	|	ВложенныйЗапрос.Номенклатура.ЕдиницаИзмеренияСрокаГодности КАК ЕдиницаИзмеренияСрокаГодности
	|ИЗ
	|	тТовары КАК тТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			МАКСИМУМ(ШтрихкодыНоменклатуры.Штрихкод) КАК Штрихкод,
	|			ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	|			ШтрихкодыНоменклатуры.Характеристика КАК Характеристика
	|		ИЗ
	|			РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|		ГДЕ
	|			ШтрихкодыНоменклатуры.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|			И (ШтрихкодыНоменклатуры.Номенклатура, ШтрихкодыНоменклатуры.Характеристика) В
	|					(ВЫБРАТЬ
	|						тТовары.Номенклатура КАК Номенклатура,
	|						тТовары.Характеристика КАК Характеристика
	|					ИЗ
	|						тТовары КАК тТовары)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ШтрихкодыНоменклатуры.Номенклатура,
	|			ШтрихкодыНоменклатуры.Характеристика) КАК ВложенныйЗапрос
	|		ПО тТовары.Номенклатура = ВложенныйЗапрос.Номенклатура
	|			И тТовары.Характеристика = ВложенныйЗапрос.Характеристика";
	тТовары = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.Прямой);			   
	тДанныеСерий = Новый ТаблицаЗначений;
	к = тДанныеСерий.Колонки;
	к.Добавить("ГТИН",отстрока);
	к.Добавить("Партия",отСтрока);
	к.Добавить("Количество",отЧисло15_13);
	к.Добавить("ДатаПроизводства",отДата);
	к.Добавить("ДатаОкончанияСрокаГодности", отДата);
	к.Добавить("ШтрихКод",отСтрока);
	Для Каждого стрПартия Из мПартии Цикл
		стр = тДанныеСерий.Добавить();
		стр.ГТИН = стрПартия.gtin;
		стр.Партия = стрПартия.part;
		стр.Количество = стрПартия.quant;
		ДатаПроизводства = Дата(
		2000+Число(Сред(стр.Партия,15,2)),
		Число(Сред(стр.Партия,17,2)),
		Число(Сред(стр.Партия,19,2))
		);
		стр.ДатаПроизводства = ДатаПроизводства;
		стр.ШтрихКод = сред(стр.Партия,2,13);
		мСтрокиТовары = тТовары.НайтиСтроки(Новый Структура("ШтрихкодНоменклатуры",Сред(стр.Партия,2,13) ));
		Если мСтрокиТовары.Количество() > 0 Тогда
			НайденнаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
			Для Каждого сСтрокаТовары из мСтрокиТовары Цикл
				Если НайденнаяНоменклатура <> Справочники.Номенклатура.ПустаяСсылка() и НайденнаяНоменклатура <> сСтрокаТовары.Номенклатура Тогда
					ВызватьИсключение(СтрШаблон("В одно документе по штрихкоду %1, найдены разные номенклатурные позиции. Заполнение невозможно",Сред(стр.Партия,2,13)));
				КонецЕсли;
				НайденнаяНоменклатура = сСтрокаТовары.Номенклатура;
			КонецЦикла;
			стр.ДатаОкончанияСрокаГодности =  НоменклатураКлиентСервер.ГоденДоПоДатеПроизводства(стр.ДатаПроизводства,сСтрокаТовары.СрокГодности,сСтрокаТовары.ЕдиницаИзмеренияСрокаГодности);
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("тДанныеСерий",тДанныеСерий);
	Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатурыМолочныеПродуктыСоСрокамиГодности);
	Запрос.Текст = "ВЫБРАТЬ
	|	т.ГТИН КАК ГТИН,
	|	т.Партия КАК Партия,
	|	т.Количество КАК Количество,
	|	т.ДатаПроизводства КАК ДатаПроизводства,
	|	т.ДатаОкончанияСрокаГодности КАК ДатаОкончанияСрокаГодности,
	|	т.ШтрихКод КАК ШтрихКод,
	|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки
	|ПОМЕСТИТЬ тДанныеСерий
	|ИЗ
	|	&тДанныеСерий КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тДанныеСерий.ГТИН КАК ГТИН,
	|	тДанныеСерий.Партия КАК Партия,
	|	тДанныеСерий.Количество КАК Количество,
	|	тДанныеСерий.ДатаПроизводства КАК ДатаПроизводства,
	|	тДанныеСерий.ДатаОкончанияСрокаГодности КАК ДатаОкончанияСрокаГодности,
	|	тДанныеСерий.ШтрихКод КАК ШтрихКод,
	|	МИНИМУМ(СерииНоменклатуры.Ссылка) КАК Серия,
	|	тДанныеСерий.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	тДанныеСерий КАК тДанныеСерий
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|		ПО тДанныеСерий.Партия = СерииНоменклатуры.Номер
	|			И тДанныеСерий.ДатаПроизводства = СерииНоменклатуры.ДатаПроизводства
	|			И тДанныеСерий.ДатаОкончанияСрокаГодности = СерииНоменклатуры.ГоденДо
	|			И (&ВидНоменклатуры = СерииНоменклатуры.ВидНоменклатуры)
	|			И (ЛОЖЬ = СерииНоменклатуры.ПометкаУдаления)
	|
	|СГРУППИРОВАТЬ ПО
	|	тДанныеСерий.Количество,
	|	тДанныеСерий.ДатаОкончанияСрокаГодности,
	|	тДанныеСерий.ШтрихКод,
	|	тДанныеСерий.ГТИН,
	|	тДанныеСерий.Партия,
	|	тДанныеСерий.ДатаПроизводства,
	|	тДанныеСерий.НомерСтроки";
	тДанныеСерий = Запрос.Выполнить().Выгрузить();
	// создадим недостающие серии
	СозданныеСерии = Новый Соответствие;
	Для Каждого сДанныеСерий из тДанныеСерий Цикл
		Если ЗначениеЗаполнено(сДанныеСерий.Серия) = Ложь Тогда
			Ключ = ""+сДанныеСерий.Партия+сДанныеСерий.ДатаПроизводства+сДанныеСерий.ДатаОкончанияСрокаГодности;
			Серия = СозданныеСерии.Получить(Ключ);
			Если Серия = Неопределено Тогда
				оСерия = Справочники.СерииНоменклатуры.СоздатьЭлемент();
				оСерия.Номер = сДанныеСерий.Партия;
				осерия.ДатаПроизводства = сДанныеСерий.ДатаПроизводства;
				осерия.ГоденДо = сДанныеСерий.ДатаОкончанияСрокаГодности;
				оСерия.ВидНоменклатуры = ВидНоменклатурыМолочныеПродуктыСоСрокамиГодности;
				оСерия.Записать();
				Серия = оСерия.Ссылка;
				СозданныеСерии.Вставить(Ключ,Серия);
			КонецЕсли;
			сДанныеСерий.Серия = Серия;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого сТовары из тТовары Цикл
		мСтрокиСерий = тДанныеСерий.НайтиСтроки(Новый Структура("ШтрихКод,Количество",сТовары.ШтрихкодНоменклатуры,сТовары.Количество ));
		Если мстрокиСерий.Количество() > 0 Тогда
			сТовары.Серия = мСтрокиСерий[0].Серия;
			мСтрокиСерий[0].Количество = 0;
		КонецЕсли;
		
	КонецЦикла;
	//Конец заполнения серий
	Товары.Загрузить(тТовары);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыПоТоварамКПоступлению(ВидЗаполнения,ДатаПоступления,_Объект) Экспорт
	Распоряжение = _Объект.Распоряжение;
	Отправитель = _Объект.Отправитель;
	Товары = _Объект.Товары;
	Ссылка = _Объект.Ссылка;
	Склад = _Объект.Склад;
	Дата = _Объект.Дата;
	Помещение = _Объект.Помещение;
	ДатаПоступления = ТекущаяДата();
	
	ИспользоватьАдресноеХранение = СкладыСервер.ИспользоватьАдресноеХранение(Склад, Помещение, Дата);
	
	Если _Объект.СкладскаяОперация = Перечисления.СкладскиеОперации.ПриемкаПоПеремещению Тогда
		
		Запрос = Новый Запрос;	
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТоварыКПоступлению.Номенклатура КАК Номенклатура,
		|	ТоварыКПоступлению.Характеристика КАК Характеристика,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТоварыКПоступлению.Назначение) КАК Назначение
		|ПОМЕСТИТЬ НазначенияТоваров
		|ИЗ
		|	РегистрНакопления.ТоварыКПоступлению КАК ТоварыКПоступлению
		|ГДЕ
		|	ТоварыКПоступлению.ДокументПоступления = &Распоряжение
		|	И  ТоварыКПоступлению.Отправитель = &Отправитель
		|	И ТоварыКПоступлению.КОформлениюОрдеров > 0
		|	И ТоварыКПоступлению.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыКПоступлению.Характеристика,
