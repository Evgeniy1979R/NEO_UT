		ЗаполнитьТоварыПоТоварамКПоступлению("НоменклатураКоличество",ДатаПоступления,Объект);
		//Заполнение серий      
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПриобретениеТоваровУслугДополнительныеРеквизиты.Ссылка КАК Ссылка,
